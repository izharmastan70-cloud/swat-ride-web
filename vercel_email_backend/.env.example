# REFERENCE NAMES ONLY. DO NOT COMMIT REAL VALUES.
# Phase 44-F3D-C does not read these values yet.
BREVO_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
SWAT_RIDE_FIREBASE_PROJECT_ID=
EMAIL_LIVE_SEND_ENABLED=false
# A Pakistan-capable local WhatsApp/SMS relay. It receives JSON fields
# recipientPhone and messageBody; the token is optional but recommended.
PASSENGER_WHATSAPP_RELAY_URL=
PASSENGER_WHATSAPP_RELAY_TOKEN=
# PBX / SIP gateway webhook authentication. Keep this only in Vercel secrets.
PBX_WEBHOOK_SECRET=
# Optional address-to-coordinate adapter used by /api/calls/dispatch. Raw
# "latitude,longitude" intake answers work without a provider URL.
GEOCODING_PROVIDER_URL=
GEOCODING_PROVIDER_API_KEY=
# Public Mapbox token used by the voice-dispatch geocoding fallback.
MAPBOX_ACCESS_TOKEN=replace_with_mapbox_public_access_token
# Used only by Vercel Cron when invoking /api/billing/daily.
CRON_SECRET=
# E.164 phone number for Super Admin billing-expiry WhatsApp alerts.
SUPER_ADMIN_ALERT_PHONE=
FACEBOOK_PAGE_ID=1358808947308489
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional: set this after discovering it from the Facebook Page. When unset,
# the Instagram publisher discovers it through the Graph API for each post.
INSTAGRAM_BUSINESS_ACCOUNT_ID=