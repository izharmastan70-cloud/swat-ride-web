import 'package:flutter_test/flutter_test.dart';

import 'package:swat_ride/ai_agent/constants/agent_omnichannel_constants.dart';
import 'package:swat_ride/ai_agent/data/initial_agent_roles_seed.dart';
import 'package:swat_ride/ai_agent/models/agent_omnichannel_channel_control.dart';
import 'package:swat_ride/ai_agent/models/agent_omnichannel_failure_isolation.dart';
import 'package:swat_ride/ai_agent/models/agent_omnichannel_observability_event.dart';
import 'package:swat_ride/ai_agent/models/agent_omnichannel_raw_ingress.dart';
import 'package:swat_ride/ai_agent/models/agent_omnichannel_replay_assessment.dart';
import 'package:swat_ride/ai_agent/models/agent_role.dart';
import 'package:swat_ride/ai_agent/services/agent_omnichannel_controlled_routing_gate.dart';
import 'package:swat_ride/ai_agent/services/agent_omnichannel_failure_isolation_policy.dart';

void main() {
  const AgentOmnichannelControlledRoutingGate gate =
      AgentOmnichannelControlledRoutingGate();

  const AgentOmnichannelFailureIsolationPolicy failurePolicy =
      AgentOmnichannelFailureIsolationPolicy();

  AgentOmnichannelChannelControlSnapshot controls({
    bool global = true,
    bool appChat = true,
    bool customerWhatsApp = true,
    bool ownerWhatsApp = true,
    bool emergencyWhatsApp = true,
    bool email = true,
    bool phoneCall = true,
    bool ownerVoice = true,
    bool whatsAppProvider = true,
    String actor = AgentOmnichannelControlActorRole.superAdmin,
  }) {
    return AgentOmnichannelChannelControlSnapshot(
      globalOmnichannelEnabled: global,
      appChatEnabled: appChat,
      customerWhatsAppEnabled: customerWhatsApp,
      ownerWhatsAppEnabled: ownerWhatsApp,
      emergencyWhatsAppEnabled: emergencyWhatsApp,
      emailEnabled: email,
      phoneCallEnabled: phoneCall,
      ownerVoiceEnabled: ownerVoice,
      whatsAppProviderLiveEnabled: whatsAppProvider,
      updatedByRoleId: actor,
      updatedAt: DateTime.utc(2026, 8, 19, 7, 30),
    );
  }

  AgentOmnichannelRawIngress raw({
    required String id,
    required String channel,
    required String roleId,
    bool trusted = true,
    bool strongReauth = false,
  }) {
    return AgentOmnichannelRawIngress(
      rawIngressId: id,
      channel: channel,
      externalMessageRef: 'ext_$id',
      intendedAgentRoleId: roleId,
      receivedAt: DateTime.utc(2026, 8, 19, 7, 31),
      sanitizedText: 'Safe channel control test.',
      subjectRef: 'subject_step1f_001',
      identityAssurance: strongReauth
          ? AgentOmnichannelIdentityAssurance.strongReauth
          : trusted
          ? AgentOmnichannelIdentityAssurance.verifiedSession
          : AgentOmnichannelIdentityAssurance.asserted,
      verifiedByTrustedBoundary: trusted,
      strongReauthSatisfied: strongReauth,
      fromChannelClaimOnly: !trusted,
      containsRawSecrets: false,
      containsPaymentCredentials: false,
      containsAuthToken: false,
      containsGovernmentId: false,
      containsUnredactedContactDetails: false,
      redactionApplied: true,
    );
  }

  AgentOmnichannelReplayWindow replayWindow() {
    return AgentOmnichannelReplayWindow(
      seenExternalMessageRefs: const <String>[],
      seenEnvelopeIds: const <String>[],
      notBefore: DateTime.utc(2026, 8, 19, 7, 0),
    );
  }

  group('Phase 51 Step 1F controls + isolation', () {
    test('all seven channels are independently controllable', () {
      final snapshot = controls();

      for (final String channel in AgentOmnichannelChannel.values) {
        expect(snapshot.isChannelEnabled(channel), isTrue);
      }

      expect(AgentOmnichannelChannel.values.length, 7);
    });

    test('Customer WhatsApp OFF does not disable Emergency WhatsApp', () {
      final snapshot = controls(
        customerWhatsApp: false,
        emergencyWhatsApp: true,
      );

      expect(
        snapshot.isRouteEnabled(AgentOmnichannelChannel.customerWhatsApp),
        isFalse,
      );

      expect(
        snapshot.isRouteEnabled(AgentOmnichannelChannel.emergencyWhatsApp),
        isTrue,
      );
    });

    test('Emergency WhatsApp OFF does not disable Customer WhatsApp', () {
      final snapshot = controls(
        customerWhatsApp: true,
        emergencyWhatsApp: false,
      );

      expect(
        snapshot.isRouteEnabled(AgentOmnichannelChannel.customerWhatsApp),
        isTrue,
      );

      expect(
        snapshot.isRouteEnabled(AgentOmnichannelChannel.emergencyWhatsApp),
        isFalse,
      );
    });

    test(
      'WhatsApp provider OFF blocks WhatsApp but not App Email Call Voice',
      () {
        final snapshot = controls(whatsAppProvider: false);

        expect(
          snapshot.isRouteEnabled(AgentOmnichannelChannel.customerWhatsApp),
          isFalse,
        );
        expect(
          snapshot.isRouteEnabled(AgentOmnichannelChannel.ownerWhatsApp),
          isFalse,
        );
        expect(
          snapshot.isRouteEnabled(AgentOmnichannelChannel.emergencyWhatsApp),
          isFalse,
        );

        expect(
          snapshot.isRouteEnabled(AgentOmnichannelChannel.appChat),
          isTrue,
        );
        expect(snapshot.isRouteEnabled(AgentOmnichannelChannel.email), isTrue);
        expect(
          snapshot.isRouteEnabled(AgentOmnichannelChannel.phoneCall),
          isTrue,
        );
        expect(
          snapshot.isRouteEnabled(AgentOmnichannelChannel.ownerVoice),
          isTrue,
        );
      },
    );

    test(
      'Global Omnichannel OFF blocks all channels but not core SWAT RIDE',
      () {
        final snapshot = controls(global: false);

        for (final String channel in AgentOmnichannelChannel.values) {
          expect(snapshot.isRouteEnabled(channel), isFalse);
        }

        expect(snapshot.coreSwatRideEnabledByThisSnapshot, isTrue);
      },
    );

    test('only Admin/Super Admin may author a channel-control snapshot', () {
      expect(controls().validate, returnsNormally);

      expect(
        controls(actor: AgentOmnichannelControlActorRole.admin).validate,
        returnsNormally,
      );

      expect(
        controls(actor: 'customer').validate,
        throwsA(isA<AgentOmnichannelChannelControlException>()),
      );
    });

    test('control update request is non-persistent and authority-free', () {
      const request = AgentOmnichannelChannelControlUpdateRequest(
        requestId: 'control_request_001',
        actorRoleId: AgentOmnichannelControlActorRole.superAdmin,
        channel: AgentOmnichannelChannel.customerWhatsApp,
        enabled: false,
        requestedAt: DateTime.utc(2026, 8, 19, 7, 40),
      );

      expect(request.validate, returnsNormally);
      expect(request.directlyPersistsChange, isFalse);
      expect(request.grantsAuthority, isFalse);
      expect(request.changesProviderStateByItself, isFalse);
    });

    test('Customer WhatsApp OFF fails closed at controlled routing gate', () {
      final result = gate.evaluate(
        raw: raw(
          id: 'customer_wa_off',
          channel: AgentOmnichannelChannel.customerWhatsApp,
          roleId: 'customer_whatsapp_agent',
        ),
        replayWindow: replayWindow(),
        controls: controls(customerWhatsApp: false),
      );

      expect(result.routeMayProceed, isFalse);
      expect(result.controlDecision.channelEnabled, isFalse);
      expect(
        result.auditEvent.eventType,
        AgentOmnichannelAuditEventType.channelDisabled,
      );
      expect(result.coreSwatRideAffected, isFalse);
    });

    test('Emergency remains routable when only Customer WhatsApp is OFF', () {
      final result = gate.evaluate(
        raw: raw(
          id: 'emergency_independent',
          channel: AgentOmnichannelChannel.emergencyWhatsApp,
          roleId: 'emergency_whatsapp_agent',
        ),
        replayWindow: replayWindow(),
        controls: controls(customerWhatsApp: false, emergencyWhatsApp: true),
      );

      expect(result.routeMayProceed, isTrue);
      expect(result.controlDecision.channelEnabled, isTrue);
      expect(
        result.auditEvent.eventType,
        AgentOmnichannelAuditEventType.routeAllowed,
      );
    });

    test('WhatsApp provider OFF does not block Email controlled route', () {
      final result = gate.evaluate(
        raw: raw(
          id: 'email_provider_isolated',
          channel: AgentOmnichannelChannel.email,
          roleId: 'email_agent',
        ),
        replayWindow: replayWindow(),
        controls: controls(whatsAppProvider: false),
      );

      expect(result.routeMayProceed, isTrue);
      expect(result.controlDecision.transportEnabled, isTrue);
    });

    test('audit event is privacy-minimized', () {
      final result = gate.evaluate(
        raw: raw(
          id: 'audit_minimized',
          channel: AgentOmnichannelChannel.appChat,
          roleId: 'support_agent',
        ),
        replayWindow: replayWindow(),
        controls: controls(),
      );

      final Map<String, dynamic> map = result.auditEvent.toSafeMap();

      expect(map['containsRawMessageContent'], isFalse);
      expect(map['containsRawIdentity'], isFalse);
      expect(map['containsPaymentCredentials'], isFalse);
      expect(map['containsAuthToken'], isFalse);
      expect(map['grantsAuthority'], isFalse);
      expect(map['invokesProvider'], isFalse);
      expect(map['writesBusinessData'], isFalse);
    });

    test(
      'single-channel failure stays isolated from other channels and core',
      () {
        final signal = AgentOmnichannelFailureSignal(
          failureId: 'failure_001',
          channel: AgentOmnichannelChannel.customerWhatsApp,
          failureType: AgentOmnichannelFailureType.providerUnavailable,
          detectedAt: DateTime.utc(2026, 8, 19, 7, 50),
        );

        final decision = failurePolicy.isolate(signal);

        expect(decision.failedChannelBlocked, isTrue);
        expect(decision.otherChannelsRemainAvailable, isTrue);
        expect(decision.coreSwatRideRemainsAvailable, isTrue);
        expect(decision.globalShutdownTriggered, isFalse);
        expect(decision.providerRestartedByThisDecision, isFalse);
      },
    );

    test('controlled gate invokes no provider/orchestrator/business write', () {
      expect(gate.invokesOrchestrator, isFalse);
      expect(gate.invokesTargetAgent, isFalse);
      expect(gate.invokesProvider, isFalse);
      expect(gate.writesBusinessData, isFalse);
      expect(gate.persistsControlSettings, isFalse);
      expect(gate.persistsAuditEvents, isFalse);
      expect(gate.coreSwatRideControlAllowed, isFalse);
    });

    test(
      'existing channel roles remain and call_agent stays exact four actions',
      () {
        final List<AgentRole> roles = buildInitialAgentRoles();

        const Set<String> expectedRoles = <String>{
          'support_agent',
          'customer_whatsapp_agent',
          'owner_whatsapp_agent',
          'emergency_whatsapp_agent',
          'email_agent',
          'call_agent',
          'voice_super_admin_agent',
        };

        expect(
          roles.map((AgentRole role) => role.roleId).toSet(),
          containsAll(expectedRoles),
        );

        final AgentRole callRole = roles.firstWhere(
          (AgentRole role) => role.roleId == 'call_agent',
        );

        expect(callRole.allowedActions.length, 4);
      },
    );
  });
}
