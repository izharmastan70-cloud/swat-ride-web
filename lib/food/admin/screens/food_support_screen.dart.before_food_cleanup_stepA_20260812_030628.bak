class _FoodSupportTicket {
  const _FoodSupportTicket({
    required this.id,
    required this.userId,
    required this.userName,
    required this.userPhone,
    required this.userType,
    required this.title,
    required this.description,
    required this.orderId,
    required this.restaurantId,
    required this.riderId,
    required this.status,
    required this.priority,
    required this.assignedAdminId,
    required this.assignedAdminName,
    required this.replies,
    required this.createdAt,
    required this.updatedAt,
    required this.resolvedAt,
    required this.closedAt,
  });

  final String id;
  final String userId;
  final String userName;
  final String userPhone;
  final _FoodSupportUserType userType;
  final String title;
  final String description;
  final String orderId;
  final String restaurantId;
  final String riderId;
  final _FoodSupportTicketStatus status;
  final _FoodSupportPriority priority;
  final String assignedAdminId;
  final String assignedAdminName;
  final List<_FoodSupportReply> replies;
  final DateTime createdAt;
  final DateTime updatedAt;
  final DateTime? resolvedAt;
  final DateTime? closedAt;

  factory _FoodSupportTicket.fromMap({
    required String id,
    required Map<String, dynamic> map,
  }) {
    return _FoodSupportTicket(
      id: id,
      userId: _stringValue(
        map['userId'],
      ),
      userName: _stringValue(
        map['userName'],
        fallback: 'Unknown User',
      ),
      userPhone: _stringValue(
        map['userPhone'],
      ),
      userType: _userTypeValue(
        map['userType'],
      ),
      title: _stringValue(
        map['title'],
        fallback: 'Food Support Ticket',
      ),
      description: _stringValue(
        map['description'],
      ),
      orderId: _stringValue(
        map['orderId'],
      ),
      restaurantId: _stringValue(
        map['restaurantId'],
      ),
      riderId: _stringValue(
        map['riderId'],
      ),
      status: _statusValue(
        map['status'],
      ),
      priority: _priorityValue(
        map['priority'],
      ),
      assignedAdminId: _stringValue(
        map['assignedAdminId'],
      ),
      assignedAdminName: _stringValue(
        map['assignedAdminName'],
      ),
      replies: _replyListValue(
        map['replies'],
      ),
      createdAt: _dateTimeValue(
            map['createdAt'],
          ) ??
          DateTime.now(),
      updatedAt: _dateTimeValue(
            map['updatedAt'],
          ) ??
          DateTime.now(),
      resolvedAt: _dateTimeValue(
        map['resolvedAt'],
      ),
      closedAt: _dateTimeValue(
        map['closedAt'],
      ),
    );
  }

  static String _stringValue(
    dynamic value, {
    String fallback = '',
  }) {
    final String text =
        value?.toString().trim() ?? '';

    return text.isEmpty ? fallback : text;
  }

  static _FoodSupportUserType _userTypeValue(
    dynamic value,
  ) {
    final String text =
        value?.toString().trim().toLowerCase() ??
            '';

    if (text == 'restaurant') {
      return _FoodSupportUserType.restaurant;
    }

    if (text == 'rider') {
      return _FoodSupportUserType.rider;
    }

    return _FoodSupportUserType.customer;
  }

  static _FoodSupportTicketStatus _statusValue(
    dynamic value,
  ) {
    final String text =
        value?.toString().trim().toLowerCase() ??
            '';

    if (text == 'inprogress' ||
        text == 'in_progress') {
      return _FoodSupportTicketStatus.inProgress;
    }

    if (text == 'resolved') {
      return _FoodSupportTicketStatus.resolved;
    }

    if (text == 'closed') {
      return _FoodSupportTicketStatus.closed;
    }

    return _FoodSupportTicketStatus.open;
  }

  static _FoodSupportPriority _priorityValue(
    dynamic value,
  ) {
    final String text =
        value?.toString().trim().toLowerCase() ??
            '';

    if (text == 'medium') {
      return _FoodSupportPriority.medium;
    }

    if (text == 'high') {
      return _FoodSupportPriority.high;
    }

    if (text == 'critical') {
      return _FoodSupportPriority.critical;
    }

    return _FoodSupportPriority.low;
  }

  static List<_FoodSupportReply>
      _replyListValue(
    dynamic value,
  ) {
    if (value is! Iterable) {
      return const <_FoodSupportReply>[];
    }

    return value
        .whereType<Map>()
        .map(
          (Map item) =>
              _FoodSupportReply.fromMap(
            Map<String, dynamic>.from(item),
          ),
        )
        .toList();
  }

  static DateTime? _dateTimeValue(
    dynamic value,
  ) {
    if (value == null) {
      return null;
    }

    if (value is DateTime) {
      return value;
    }

    try {
      final dynamic converted =
          value.toDate();

      if (converted is DateTime) {
        return converted;
      }
    } catch (_) {
      // Supports Firestore Timestamp.
    }

    return DateTime.tryParse(
      value.toString(),
    );
  }
}

class _FoodSupportReply {
  const _FoodSupportReply({
    required this.id,
    required this.senderId,
    required this.senderName,
    required this.message,
    required this.isInternalNote,
    required this.createdAt,
  });

  final String id;
  final String senderId;
  final String senderName;
  final String message;
  final bool isInternalNote;
  final DateTime createdAt;

  factory _FoodSupportReply.fromMap(
    Map<String, dynamic> map,
  ) {
    return _FoodSupportReply(
      id: map['id']?.toString() ?? '',
      senderId:
          map['senderId']?.toString() ?? '',
      senderName:
          map['senderName']?.toString() ??
              'Unknown',
      message:
          map['message']?.toString() ?? '',
      isInternalNote:
          _boolValue(map['isInternalNote']),
      createdAt:
          _FoodSupportTicket._dateTimeValue(
            map['createdAt'],
          ) ??
          DateTime.now(),
    );
  }

  Map<String, dynamic> toMap() {
    return <String, dynamic>{
      'id': id,
      'senderId': senderId,
      'senderName': senderName,
      'message': message,
      'isInternalNote': isInternalNote,
      'createdAt':
          createdAt.toIso8601String(),
    };
  }

  static bool _boolValue(
    dynamic value,
  ) {
    if (value is bool) {
      return value;
    }

    if (value is num) {
      return value != 0;
    }

    final String text =
        value?.toString().trim().toLowerCase() ??
            '';

    return text == 'true' ||
        text == '1' ||
        text == 'yes';
  }
}

class _SupportFilterItem {
  const _SupportFilterItem({
    required this.filter,
    required this.label,
  });

  final _FoodSupportFilter filter;
  final String label;
}
