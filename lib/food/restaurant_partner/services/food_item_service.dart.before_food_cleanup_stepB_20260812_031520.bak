  // ===========================================================
  // ADMIN CONTROLS
  // ===========================================================

  Future<void> approveFoodItem({
    required String restaurantId,
    required String foodItemId,
  }) {
    return updateFoodItemFields(
      restaurantId: restaurantId,
      foodItemId: foodItemId,
      fields: <String, dynamic>{
        'approvedByAdmin': true,
        'rejectionReason': '',
        'status':
            RestaurantFoodItemStatus.active.value,
        'isVisible': true,
      },
    );
  }

  Future<void> rejectFoodItem({
    required String restaurantId,
    required String foodItemId,
    required String reason,
  }) {
    return updateFoodItemFields(
      restaurantId: restaurantId,
      foodItemId: foodItemId,
      fields: <String, dynamic>{
        'approvedByAdmin': false,
        'rejectionReason': reason.trim(),
        'status':
            RestaurantFoodItemStatus.rejected.value,
        'isVisible': false,
      },
    );
  }

  // ===========================================================
  // REORDER ITEMS
  // ===========================================================

  Future<void> reorderFoodItems({
    required String restaurantId,
    required List<RestaurantFoodItemModel> items,
  }) async {
    _validateRestaurantId(restaurantId);

    if (items.isEmpty) {
      return;
    }

    try {
      final WriteBatch batch = _firestore.batch();
      final DateTime now = DateTime.now();

      for (int index = 0;
          index < items.length;
          index++) {
        final RestaurantFoodItemModel item =
            items[index];

        if (item.id.trim().isEmpty) {
          continue;
        }

        batch.update(
          _itemsRef(restaurantId).doc(item.id),
          <String, dynamic>{
            'sortOrder': index,
            'updatedAt': now.toIso8601String(),
          },
        );
      }

      await batch.commit();
    } on FirebaseException catch (error) {
      throw FoodItemServiceException(
        message: _firebaseMessage(error),
        code: error.code,
      );
    } catch (error) {
      throw FoodItemServiceException(
        message: 'Unable to reorder food items: $error',
      );
    }
  }

  // ===========================================================
  // DELETE FOOD ITEM
  // ===========================================================

  Future<void> deleteFoodItem({
    required String restaurantId,
    required String foodItemId,
  }) async {
    _validateRestaurantId(restaurantId);

    if (foodItemId.trim().isEmpty) {
      throw const FoodItemServiceException(
        message: 'Food item ID is required.',
      );
    }

    try {
      final DocumentReference<Map<String, dynamic>> document =
          _itemsRef(restaurantId).doc(foodItemId);

      final DocumentSnapshot<Map<String, dynamic>> snapshot =
          await document.get();

      if (!snapshot.exists || snapshot.data() == null) {
        return;
      }

      final String categoryId =
          snapshot.data()!['categoryId']
                  ?.toString()
                  .trim() ??
              '';

      final DateTime now = DateTime.now();

      await _firestore.runTransaction(
        (Transaction transaction) async {
          transaction.delete(document);

          if (categoryId.isNotEmpty) {
            await _updateCategoryCountInTransaction(
              transaction: transaction,
              restaurantId: restaurantId,
              categoryId: categoryId,
              delta: -1,
              now: now,
            );
          }
        },
      );
    } on FirebaseException catch (error) {
      throw FoodItemServiceException(
        message: _firebaseMessage(error),
        code: error.code,
      );
    } catch (error) {
      throw FoodItemServiceException(
        message: 'Unable to delete food item: $error',
      );
    }
  }

  // ===========================================================
  // BATCH SAVE
  // ===========================================================

  Future<void> saveFoodItemsBatch({
    required String restaurantId,
    required List<RestaurantFoodItemModel> items,
  }) async {
    _validateRestaurantId(restaurantId);

    if (items.isEmpty) {
      return;
    }

    try {
      final WriteBatch batch = _firestore.batch();
      final DateTime now = DateTime.now();

      for (final RestaurantFoodItemModel item in items) {
        final DocumentReference<Map<String, dynamic>> document =
            item.id.trim().isEmpty
                ? _itemsRef(restaurantId).doc()
                : _itemsRef(restaurantId).doc(item.id);

        batch.set(
          document,
          item
              .copyWith(
                id: document.id,
                restaurantId: restaurantId,
                updatedAt: now,
              )
              .toMap(),
          SetOptions(merge: true),
        );
      }

      await batch.commit();
    } on FirebaseException catch (error) {
      throw FoodItemServiceException(
        message: _firebaseMessage(error),
        code: error.code,
      );
    } catch (error) {
      throw FoodItemServiceException(
        message: 'Unable to save food items: $error',
      );
    }
  }

  // ===========================================================
  // CATEGORY COUNT HELPER
  // ===========================================================

  Future<void> _updateCategoryCountInTransaction({
    required Transaction transaction,
    required String restaurantId,
    required String categoryId,
    required int delta,
    required DateTime now,
  }) async {
    final DocumentReference<Map<String, dynamic>>
        categoryDocument = _firestore
            .collection(restaurantsCollection)
            .doc(restaurantId)
            .collection('menu_categories')
            .doc(categoryId);

    final DocumentSnapshot<Map<String, dynamic>>
        categorySnapshot =
        await transaction.get(categoryDocument);

    if (!categorySnapshot.exists) {
      return;
    }

    final int currentCount =
        _intValue(
      categorySnapshot.data()?['totalItems'],
    );

    final int nextCount =
        (currentCount + delta).clamp(0, 1 << 31);

    transaction.update(
      categoryDocument,
      <String, dynamic>{
        'totalItems': nextCount,
        'updatedAt': now.toIso8601String(),
      },
    );
  }

  // ===========================================================
  // INTERNAL MAPPERS
  // ===========================================================

  RestaurantFoodItemModel _itemFromSnapshot(
    DocumentSnapshot<Map<String, dynamic>> snapshot, {
    required String restaurantId,
  }) {
    final Map<String, dynamic> data =
        Map<String, dynamic>.from(
      snapshot.data() ?? const <String, dynamic>{},
    );

    data['id'] = snapshot.id;
    data['restaurantId'] = restaurantId;

    return RestaurantFoodItemModel.fromMap(data);
  }

  List<RestaurantFoodItemModel> _itemListFromQuery(
    QuerySnapshot<Map<String, dynamic>> snapshot, {
    required String restaurantId,
    required bool customerOnly,
  }) {
    final List<RestaurantFoodItemModel> items =
        snapshot.docs
            .map(
              (
                DocumentSnapshot<Map<String, dynamic>>
                    document,
              ) =>
                  _itemFromSnapshot(
                document,
                restaurantId: restaurantId,
              ),
            )
            .where(
              (RestaurantFoodItemModel item) =>
                  !customerOnly ||
                  item.canShowToCustomer,
            )
            .toList();

    items.sort(
      (
        RestaurantFoodItemModel first,
        RestaurantFoodItemModel second,
      ) {
        if (first.isFeatured != second.isFeatured) {
          return first.isFeatured ? -1 : 1;
        }

        if (first.isPopular != second.isPopular) {
          return first.isPopular ? -1 : 1;
        }

        final int sortComparison =
            first.sortOrder.compareTo(
          second.sortOrder,
        );

        if (sortComparison != 0) {
          return sortComparison;
        }

        return first.name.toLowerCase().compareTo(
              second.name.toLowerCase(),
            );
      },
    );

    return items;
  }

  // ===========================================================
  // VALIDATION
  // ===========================================================

  void _validateRestaurantId(
    String restaurantId,
  ) {
    if (restaurantId.trim().isEmpty) {
      throw const FoodItemServiceException(
        message: 'Restaurant ID is required.',
      );
    }
  }

  void _validateRequiredFields(
    RestaurantFoodItemModel item,
  ) {
    if (item.name.trim().isEmpty) {
      throw const FoodItemServiceException(
        message: 'Food item name is required.',
      );
    }

    if (item.categoryId.trim().isEmpty) {
      throw const FoodItemServiceException(
        message: 'Food category is required.',
      );
    }

    if (item.originalPrice < 0) {
      throw const FoodItemServiceException(
        message: 'Food item price cannot be negative.',
      );
    }

    if (item.preparationTimeMinutes < 0) {
      throw const FoodItemServiceException(
        message:
            'Preparation time cannot be negative.',
      );
    }
  }

  static int _intValue(dynamic value) {
    if (value is int) {
      return value;
    }

    if (value is num) {
      return value.toInt();
    }

    return int.tryParse(
          value?.toString() ?? '',
        ) ??
        0;
  }

  String _firebaseMessage(
    FirebaseException error,
  ) {
    switch (error.code) {
      case 'permission-denied':
        return 'You do not have permission to manage these food items.';
      case 'unavailable':
        return 'Firebase is temporarily unavailable. Please try again.';
      case 'not-found':
        return 'The requested food item was not found.';
      case 'already-exists':
        return 'This food item already exists.';
      case 'failed-precondition':
        return 'Firebase requires an index or another condition before this action can run.';
      case 'aborted':
        return 'The food item update was interrupted. Please try again.';
      default:
        return error.message ??
            'A Firebase error occurred (${error.code}).';
    }
  }
}

class FoodItemServiceException implements Exception {
  const FoodItemServiceException({
    required this.message,
    this.code = '',
  });

  final String message;
  final String code;

  @override
  String toString() {
    if (code.trim().isEmpty) {
      return message;
    }

    return 'FoodItemServiceException($code): $message';
  }
}
