  Widget _headerCard() {
    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: darkCard,
        borderRadius:
            BorderRadius.circular(18),
        border: Border.all(
          color: yellow.withValues(
            alpha: 0.22,
          ),
        ),
      ),
      child: const Row(
        children: [
          Icon(
            Icons.settings_suggest_outlined,
            color: yellow,
            size: 34,
          ),
          SizedBox(width: 12),
          Expanded(
            child: Text(
              'All Tourism features can be controlled without publishing an app update.',
              style: TextStyle(
                color: Colors.grey,
                height: 1.4,
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _section({
    required String title,
    required IconData icon,
    required List<Widget> children,
  }) {
    return Container(
      margin:
          const EdgeInsets.only(
        bottom: 14,
      ),
      padding: const EdgeInsets.all(15),
      decoration: BoxDecoration(
        color: darkCard,
        borderRadius:
            BorderRadius.circular(17),
      ),
      child: Column(
        children: [
          Row(
            children: [
              Icon(
                icon,
                color: yellow,
              ),
              const SizedBox(width: 9),
              Expanded(
                child: Text(
                  title,
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 17,
                    fontWeight:
                        FontWeight.bold,
                  ),
                ),
              ),
            ],
          ),
          const SizedBox(height: 8),
          ...children,
        ],
      ),
    );
  }

  Widget _switchTile({
    required String title,
    required String subtitle,
    required bool value,
    required ValueChanged<bool>
        onChanged,
  }) {
    return SwitchListTile(
      contentPadding: EdgeInsets.zero,
      title: Text(
        title,
        style: const TextStyle(
          color: Colors.white,
          fontSize: 13,
          fontWeight: FontWeight.bold,
        ),
      ),
      subtitle: Text(
        subtitle,
        style: const TextStyle(
          color: Colors.grey,
          fontSize: 10,
        ),
      ),
      value: value,
      activeThumbColor: yellow,
      onChanged: onChanged,
    );
  }

  Widget _numberTile({
    required String title,
    required int value,
    required ValueChanged<int>
        onChanged,
  }) {
    return ListTile(
      contentPadding: EdgeInsets.zero,
      title: Text(
        title,
        style: const TextStyle(
          color: Colors.white,
          fontSize: 13,
        ),
      ),
      trailing: SizedBox(
        width: 110,
        child: TextFormField(
          initialValue: '$value',
          keyboardType:
              TextInputType.number,
          textAlign: TextAlign.right,
          style: const TextStyle(
            color: Colors.white,
          ),
          onChanged: (text) {
            onChanged(
              int.tryParse(text) ?? 0,
            );
          },
          decoration:
              const InputDecoration(
            isDense: true,
          ),
        ),
      ),
    );
  }

  Widget _decimalTile({
    required String title,
    required double value,
    required ValueChanged<double>
        onChanged,
  }) {
    return ListTile(
      contentPadding: EdgeInsets.zero,
      title: Text(
        title,
        style: const TextStyle(
          color: Colors.white,
          fontSize: 13,
        ),
      ),
      trailing: SizedBox(
        width: 110,
        child: TextFormField(
          initialValue:
              value.toStringAsFixed(2),
          keyboardType:
              const TextInputType
                  .numberWithOptions(
            decimal: true,
          ),
          textAlign: TextAlign.right,
          style: const TextStyle(
            color: Colors.white,
          ),
          onChanged: (text) {
            onChanged(
              double.tryParse(text) ?? 0,
            );
          },
          decoration:
              const InputDecoration(
            isDense: true,
          ),
        ),
      ),
    );
  }

  Widget _textTile({
    required String title,
    required String value,
    required ValueChanged<String>
        onChanged,
  }) {
    return ListTile(
      contentPadding: EdgeInsets.zero,
      title: Text(
        title,
        style: const TextStyle(
          color: Colors.white,
          fontSize: 13,
        ),
      ),
      subtitle: TextFormField(
        initialValue: value,
        style: const TextStyle(
          color: Colors.white,
        ),
        onChanged: onChanged,
      ),
    );
  }

  Widget _billingNotice() {
    return Container(
      padding: const EdgeInsets.all(13),
      decoration: BoxDecoration(
        color: Colors.orange.withValues(
          alpha: 0.08,
        ),
        borderRadius:
            BorderRadius.circular(14),
        border: Border.all(
          color: Colors.orange.withValues(
            alpha: 0.24,
          ),
        ),
      ),
      child: const Row(
        crossAxisAlignment:
            CrossAxisAlignment.start,
        children: [
          Icon(
            Icons.info_outline,
            color: Colors.orange,
          ),
          SizedBox(width: 9),
          Expanded(
            child: Text(
              'Firebase Storage, paid Maps, JazzCash live API, Easypaisa live API and real wallet settlement remain disabled. Keep testing bypass enabled until those services are ready.',
              style: TextStyle(
                color: Colors.grey,
                fontSize: 10,
                height: 1.4,
              ),
            ),
          ),
        ],
      ),
    );
  }

  void _loadSettings(
    Map<String, dynamic> data,
  ) {
    bookingEnabled =
        data['bookingEnabled'] ??
            bookingEnabled;
    instantBookingEnabled =
        data['instantBookingEnabled'] ??
            instantBookingEnabled;
    manualApprovalRequired =
        data['manualApprovalRequired'] ??
            manualApprovalRequired;
    maximumAdvanceBookingDays =
        _readInt(
      data['maximumAdvanceBookingDays'],
      fallback:
          maximumAdvanceBookingDays,
    );
    minimumAdvanceBookingHours =
        _readInt(
      data['minimumAdvanceBookingHours'],
      fallback:
          minimumAdvanceBookingHours,
    );

    freeCancellationHours =
        _readInt(
      data['freeCancellationHours'],
      fallback: freeCancellationHours,
    );
    cancellationChargePercent =
        _readDouble(
      data['cancellationChargePercent'],
      fallback:
          cancellationChargePercent,
    );
    refundPercent =
        _readDouble(
      data['refundPercent'],
      fallback: refundPercent,
    );
    noShowChargeEnabled =
        data['noShowChargeEnabled'] ??
            noShowChargeEnabled;

    defaultCommissionPercent =
        _readDouble(
      data['defaultCommissionPercent'],
      fallback:
          defaultCommissionPercent,
    );
    seasonalMultiplier =
        _readDouble(
      data['seasonalMultiplier'],
      fallback: seasonalMultiplier,
    );
    weekendMultiplier =
        _readDouble(
      data['weekendMultiplier'],
      fallback: weekendMultiplier,
    );
    holidayMultiplier =
        _readDouble(
      data['holidayMultiplier'],
      fallback: holidayMultiplier,
    );
    minimumBookingPrice =
        _readDouble(
      data['minimumBookingPrice'],
      fallback: minimumBookingPrice,
    );

    driverAutoAssign =
        data['driverAutoAssign'] ??
            driverAutoAssign;
    maximumDailyToursPerDriver =
        _readInt(
      data['maximumDailyToursPerDriver'],
      fallback:
          maximumDailyToursPerDriver,
    );
    minimumDriverRating =
        _readDouble(
      data['minimumDriverRating'],
      fallback: minimumDriverRating,
    );

    guideAutoAssign =
        data['guideAutoAssign'] ??
            guideAutoAssign;
    featuredGuideEnabled =
        data['featuredGuideEnabled'] ??
            featuredGuideEnabled;
    minimumGuideRating =
        _readDouble(
      data['minimumGuideRating'],
      fallback: minimumGuideRating,
    );
    guideLanguageMatchingEnabled =
        data['guideLanguageMatchingEnabled'] ??
            guideLanguageMatchingEnabled;

    featuredPackagesEnabled =
        data['featuredPackagesEnabled'] ??
            featuredPackagesEnabled;
    hideFullyBookedPackages =
        data['hideFullyBookedPackages'] ??
            hideFullyBookedPackages;
    waitingListEnabled =
        data['waitingListEnabled'] ??
            waitingListEnabled;
    minimumGroupSize =
        _readInt(
      data['minimumGroupSize'],
      fallback: minimumGroupSize,
    );
    maximumGroupSize =
        _readInt(
      data['maximumGroupSize'],
      fallback: maximumGroupSize,
    );

    reviewsEnabled =
        data['reviewsEnabled'] ??
            reviewsEnabled;
    hideLowRatings =
        data['hideLowRatings'] ??
            hideLowRatings;
    autoApproveReviews =
        data['autoApproveReviews'] ??
            autoApproveReviews;

    customerNotificationsEnabled =
        data['customerNotificationsEnabled'] ??
            customerNotificationsEnabled;
    driverNotificationsEnabled =
        data['driverNotificationsEnabled'] ??
            driverNotificationsEnabled;
    guideNotificationsEnabled =
        data['guideNotificationsEnabled'] ??
            guideNotificationsEnabled;
    pushNotificationsEnabled =
        data['pushNotificationsEnabled'] ??
            pushNotificationsEnabled;
    emailNotificationsEnabled =
        data['emailNotificationsEnabled'] ??
            emailNotificationsEnabled;
    smsNotificationsEnabled =
        data['smsNotificationsEnabled'] ??
            smsNotificationsEnabled;

    promoCodesEnabled =
        data['promoCodesEnabled'] ??
            promoCodesEnabled;
    loyaltyEnabled =
        data['loyaltyEnabled'] ??
            loyaltyEnabled;
    referralEnabled =
        data['referralEnabled'] ??
            referralEnabled;
    cashbackEnabled =
        data['cashbackEnabled'] ??
            cashbackEnabled;

    sosEnabled =
        data['sosEnabled'] ??
            sosEnabled;
    liveTrackingEnabled =
        data['liveTrackingEnabled'] ??
            liveTrackingEnabled;
    emergencyContact =
        data['emergencyContact']
                ?.toString() ??
            emergencyContact;

    aiRecommendationsEnabled =
        data['aiRecommendationsEnabled'] ??
            aiRecommendationsEnabled;
    aiPackageRankingEnabled =
        data['aiPackageRankingEnabled'] ??
            aiPackageRankingEnabled;
    aiDestinationRankingEnabled =
        data['aiDestinationRankingEnabled'] ??
            aiDestinationRankingEnabled;

    cashEnabled =
        data['cashEnabled'] ??
            cashEnabled;
    walletEnabled =
        data['walletEnabled'] ??
            walletEnabled;
    jazzCashEnabled =
        data['jazzCashEnabled'] ??
            jazzCashEnabled;
    easypaisaEnabled =
        data['easypaisaEnabled'] ??
            easypaisaEnabled;
    testingPaymentBypassEnabled =
        data['testingPaymentBypassEnabled'] ??
            testingPaymentBypassEnabled;
  }

  Future<void> _saveSettings() async {
    setState(() {
      _isSaving = true;
    });

    try {
      await _settingsReference.set(
        <String, dynamic>{
          'bookingEnabled':
              bookingEnabled,
          'instantBookingEnabled':
              instantBookingEnabled,
          'manualApprovalRequired':
              manualApprovalRequired,
          'maximumAdvanceBookingDays':
              maximumAdvanceBookingDays,
          'minimumAdvanceBookingHours':
              minimumAdvanceBookingHours,
          'freeCancellationHours':
              freeCancellationHours,
          'cancellationChargePercent':
              cancellationChargePercent,
          'refundPercent':
              refundPercent,
          'noShowChargeEnabled':
              noShowChargeEnabled,
          'defaultCommissionPercent':
              defaultCommissionPercent,
          'seasonalMultiplier':
              seasonalMultiplier,
          'weekendMultiplier':
              weekendMultiplier,
          'holidayMultiplier':
              holidayMultiplier,
          'minimumBookingPrice':
              minimumBookingPrice,
          'driverAutoAssign':
              driverAutoAssign,
          'maximumDailyToursPerDriver':
              maximumDailyToursPerDriver,
          'minimumDriverRating':
              minimumDriverRating,
          'guideAutoAssign':
              guideAutoAssign,
          'featuredGuideEnabled':
              featuredGuideEnabled,
          'minimumGuideRating':
              minimumGuideRating,
          'guideLanguageMatchingEnabled':
              guideLanguageMatchingEnabled,
          'featuredPackagesEnabled':
              featuredPackagesEnabled,
          'hideFullyBookedPackages':
              hideFullyBookedPackages,
          'waitingListEnabled':
              waitingListEnabled,
          'minimumGroupSize':
              minimumGroupSize,
          'maximumGroupSize':
              maximumGroupSize,
          'reviewsEnabled':
              reviewsEnabled,
          'hideLowRatings':
              hideLowRatings,
          'autoApproveReviews':
              autoApproveReviews,
          'customerNotificationsEnabled':
              customerNotificationsEnabled,
          'driverNotificationsEnabled':
              driverNotificationsEnabled,
          'guideNotificationsEnabled':
              guideNotificationsEnabled,
          'pushNotificationsEnabled':
              pushNotificationsEnabled,
          'emailNotificationsEnabled':
              emailNotificationsEnabled,
          'smsNotificationsEnabled':
              smsNotificationsEnabled,
          'promoCodesEnabled':
              promoCodesEnabled,
          'loyaltyEnabled':
              loyaltyEnabled,
          'referralEnabled':
              referralEnabled,
          'cashbackEnabled':
              cashbackEnabled,
          'sosEnabled': sosEnabled,
          'liveTrackingEnabled':
              liveTrackingEnabled,
          'emergencyContact':
              emergencyContact,
          'aiRecommendationsEnabled':
              aiRecommendationsEnabled,
          'aiPackageRankingEnabled':
              aiPackageRankingEnabled,
          'aiDestinationRankingEnabled':
              aiDestinationRankingEnabled,
          'cashEnabled':
              cashEnabled,
          'walletEnabled':
              walletEnabled,
          'jazzCashEnabled':
              jazzCashEnabled,
          'easypaisaEnabled':
              easypaisaEnabled,
          'testingPaymentBypassEnabled':
              testingPaymentBypassEnabled,
          'storageUploadUsed': false,
          'updatedByRole':
              'tourism_admin',
          'updatedAt':
              FieldValue.serverTimestamp(),
        },
        SetOptions(merge: true),
      );

      if (!mounted) {
        return;
      }

      ScaffoldMessenger.of(context)
        ..hideCurrentSnackBar()
        ..showSnackBar(
          const SnackBar(
            content: Text(
              'Tourism settings saved.',
            ),
            backgroundColor: darkCard,
          ),
        );
    } catch (error) {
      if (!mounted) {
        return;
      }

      ScaffoldMessenger.of(context)
        ..hideCurrentSnackBar()
        ..showSnackBar(
          SnackBar(
            content: Text(
              'Unable to save settings: $error',
            ),
            backgroundColor: Colors.red,
          ),
        );
    } finally {
      if (mounted) {
        setState(() {
          _isSaving = false;
        });
      }
    }
  }

  int _readInt(
    dynamic value, {
    int fallback = 0,
  }) {
    if (value is int) {
      return value;
    }

    if (value is num) {
      return value.toInt();
    }

    return int.tryParse(
          value?.toString() ?? '',
        ) ??
        fallback;
  }

  double _readDouble(
    dynamic value, {
    double fallback = 0,
  }) {
    if (value is num) {
      return value.toDouble();
    }

    return double.tryParse(
          value?.toString() ?? '',
        ) ??
        fallback;
  }
}
