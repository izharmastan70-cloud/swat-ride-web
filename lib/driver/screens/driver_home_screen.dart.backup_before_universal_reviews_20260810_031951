  Widget _statusBadge({
    required bool isOnline,
    required bool isAvailable,
    required bool hasActiveRide,
  }) {
    Color color;
    String label;

    if (hasActiveRide) {
      color = Colors.orange;
      label = 'BUSY';
    } else if (isOnline && isAvailable) {
      color = Colors.green;
      label = 'ONLINE';
    } else if (isOnline) {
      color = yellow;
      label = 'PAUSED';
    } else {
      color = Colors.grey;
      label = 'OFFLINE';
    }

    return Container(
      padding: const EdgeInsets.symmetric(
        horizontal: 10,
        vertical: 7,
      ),
      decoration: BoxDecoration(
        color: color.withValues(alpha: 0.15),
        borderRadius: BorderRadius.circular(20),
      ),
      child: Row(
        children: [
          CircleAvatar(
            radius: 4,
            backgroundColor: color,
          ),
          const SizedBox(width: 6),
          Text(
            label,
            style: TextStyle(
              color: color,
              fontSize: 10,
              fontWeight: FontWeight.bold,
            ),
          ),
        ],
      ),
    );
  }

