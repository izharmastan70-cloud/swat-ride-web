  // =========================================================
  // GPS TRACKING LIFECYCLE
  // =========================================================

  void _scheduleGpsSync({
    required bool isOnline,
    required String? activeRideId,
  }) {
    final String normalizedRideId =
        activeRideId?.trim() ?? '';

    if (_lastGpsOnlineTarget == isOnline &&
        _lastGpsRideTarget == normalizedRideId) {
      return;
    }

    _lastGpsOnlineTarget = isOnline;
    _lastGpsRideTarget = normalizedRideId;

    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!mounted) return;

      _syncGpsTracking(
        isOnline: isOnline,
        activeRideId:
            normalizedRideId.isEmpty ? null : normalizedRideId,
      );
    });
  }

  Future<void> _syncGpsTracking({
    required bool isOnline,
    required String? activeRideId,
  }) async {
    if (_gpsSyncInProgress) return;
    _gpsSyncInProgress = true;

    try {
      if (!isOnline) {
        await _locationService.stopLocationTracking();

        if (mounted && _gpsStatus != 'GPS is stopped') {
          setState(() {
            _gpsStatus = 'GPS is stopped';
          });
        }
        return;
      }

      if (mounted) {
        setState(() {
          _gpsStatus = 'Starting GPS...';
        });
      }

      await _locationService.startLocationTracking(
        driverId: widget.driverId,
        activeRideId: activeRideId,
        onPosition: (_) {
          if (!mounted || _gpsStatus == 'Live GPS active') return;

          setState(() {
            _gpsStatus = 'Live GPS active';
          });
        },
        onError: (Object error) {
          if (!mounted) return;

          setState(() {
            _gpsStatus = 'GPS update failed';
          });
        },
      );
    } on DriverLocationException catch (error) {
      if (!mounted) return;

      setState(() {
        _gpsStatus = error.message;
      });
    } catch (_) {
      if (!mounted) return;

      setState(() {
        _gpsStatus = 'Unable to start GPS';
      });
    } finally {
      _gpsSyncInProgress = false;
    }
  }

  // =========================================================
  // ONLINE / OFFLINE
  // =========================================================

  Future<void> _toggleOnlineStatus({
    required bool currentOnlineStatus,
  }) async {
    if (_isUpdatingStatus) return;

    setState(() {
      _isUpdatingStatus = true;
    });

    try {
      final bool goingOnline = !currentOnlineStatus;

      if (goingOnline) {
        await _locationService.ensureLocationReady();

        await _locationService.startLocationTracking(
          driverId: widget.driverId,
          onPosition: (_) {
            if (!mounted || _gpsStatus == 'Live GPS active') return;

            setState(() {
              _gpsStatus = 'Live GPS active';
            });
          },
          onError: (Object error) {
            if (!mounted) return;

            setState(() {
              _gpsStatus = 'GPS update failed';
            });
          },
        );
      }

      await _availabilityService.setOnlineStatus(
        driverId: widget.driverId,
        isOnline: goingOnline,
        driverName: widget.driverName,
        vehicleType: widget.vehicleType,
        vehicleNumber: widget.vehicleNumber,
        allowUnapprovedForTesting:
            allowApprovalBypassForTesting,
      );

      if (!goingOnline) {
        await _locationService.stopLocationTracking();
      }

      if (!mounted) return;

      _showMessage(
        currentOnlineStatus
            ? 'You are now Offline.'
            : 'You are Online and ready for rides.',
        currentOnlineStatus
            ? Colors.grey.shade800
            : Colors.green,
      );
    } catch (error) {
      if (!currentOnlineStatus) {
        await _locationService.stopLocationTracking();
      }

      if (!mounted) return;

      _showMessage(
        _cleanError(error),
        Colors.red,
      );
    } finally {
      if (mounted) {
        setState(() {
          _isUpdatingStatus = false;
        });
      }
    }
  }

  // =========================================================
  // AVAILABILITY
  // =========================================================

  Future<void> _toggleAvailability({
    required bool isOnline,
    required bool currentAvailability,
    required bool hasActiveRide,
  }) async {
    if (_isUpdatingStatus) return;

    if (!isOnline) {
      _showMessage(
        'Please go Online first.',
        Colors.orange,
      );
      return;
    }

    if (hasActiveRide) {
      _showMessage(
        'You cannot change availability during an active ride.',
        Colors.orange,
      );
      return;
    }

    setState(() {
      _isUpdatingStatus = true;
    });

    try {
      await _availabilityService.updateAvailability(
        driverId: widget.driverId,
        isAvailable: !currentAvailability,
        allowUnapprovedForTesting:
            allowApprovalBypassForTesting,
      );

      if (!mounted) return;

      _showMessage(
        currentAvailability
            ? 'New ride requests paused.'
            : 'You are available for new rides.',
        currentAvailability
            ? Colors.orange
            : Colors.green,
      );
    } catch (error) {
      if (!mounted) return;

      _showMessage(
        _cleanError(error),
        Colors.red,
      );
    } finally {
      if (mounted) {
        setState(() {
          _isUpdatingStatus = false;
        });
      }
    }
  }

