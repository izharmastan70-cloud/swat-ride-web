  // =========================================================
  // TODAY STATS STREAM
  // =========================================================

  Stream<_DriverTodayStats> _watchTodayStats() {
    return _firestore
        .collection('rides')
        .where(
          'driverId',
          isEqualTo: widget.driverId,
        )
        .snapshots()
        .map(
      (snapshot) {
        final DateTime now = DateTime.now();

        final DateTime startOfToday = DateTime(
          now.year,
          now.month,
          now.day,
        );

        int completedRides = 0;
        double grossEarnings = 0;
        double commission = 0;

        for (final document in snapshot.docs) {
          final Map<String, dynamic> data =
              document.data();

          if (data['status'] !=
              RideModel.completed) {
            continue;
          }

          final DateTime? completedAt =
              _parseDate(data['completedAt']) ??
                  _parseDate(data['updatedAt']);

          if (completedAt == null ||
              completedAt.isBefore(startOfToday)) {
            continue;
          }

          completedRides++;

          grossEarnings +=
              (data['estimatedFare'] as num?)
                      ?.toDouble() ??
                  0;

          commission +=
              (data['commissionAmount'] as num?)
                      ?.toDouble() ??
                  0;
        }

        final double netEarnings =
            grossEarnings - commission;

        return _DriverTodayStats(
          completedRides: completedRides,
          grossEarnings: grossEarnings,
          commission: commission,
          netEarnings:
              netEarnings < 0 ? 0 : netEarnings,
        );
      },
    );
  }

  DateTime? _parseDate(
    dynamic value,
  ) {
    if (value is Timestamp) {
      return value.toDate();
    }

    if (value is DateTime) {
      return value;
    }

    if (value is String) {
      return DateTime.tryParse(value);
    }

    return null;
  }

  // =========================================================
  // MESSAGE
  // =========================================================

  void _showMessage(
    String message,
    Color color,
  ) {
    ScaffoldMessenger.of(context)
        .hideCurrentSnackBar();

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        backgroundColor: color,
        behavior: SnackBarBehavior.floating,
        content: Text(
          message,
          style: const TextStyle(
            color: Colors.white,
            fontWeight: FontWeight.w600,
          ),
        ),
      ),
    );
  }

  String _cleanError(
    Object error,
  ) {
    return error
        .toString()
        .replaceFirst('Exception: ', '');
  }

  // =========================================================
  // BUILD
  // =========================================================

  @override
  Widget build(BuildContext context) {
    return StreamBuilder<
        DocumentSnapshot<Map<String, dynamic>>>(
      stream: _availabilityService
          .watchDriverStatus(widget.driverId),
      builder: (
        context,
        driverSnapshot,
      ) {
        final Map<String, dynamic> driverData =
            driverSnapshot.data?.data() ??
                <String, dynamic>{};

        final bool isOnline =
            driverData['isOnline'] as bool? ??
                false;

        final bool isAvailable =
            driverData['isAvailable'] as bool? ??
                false;

        final String approvalStatus =
            driverData['status'] as String? ??
                'pending';

        final bool approvalBypassActive =
            driverData['approvalBypassActive']
                    as bool? ??
                false;

        final String displayName =
            (driverData['fullName'] as String?)
                        ?.trim()
                        .isNotEmpty ==
                    true
                ? driverData['fullName'] as String
                : widget.driverName;

        final String displayVehicleType =
            (driverData['vehicleType'] as String?)
                        ?.trim()
                        .isNotEmpty ==
                    true
                ? driverData['vehicleType']
                    as String
                : widget.vehicleType;

        final String displayVehicleNumber =
            (driverData['vehicleNumber']
                            as String?)
                        ?.trim()
                        .isNotEmpty ==
                    true
                ? driverData['vehicleNumber']
                    as String
                : widget.vehicleNumber;

        return StreamBuilder<RideModel?>(
          stream:
              _rideService.watchActiveDriverRide(
            widget.driverId,
          ),
          builder: (
            context,
            activeRideSnapshot,
          ) {
            final RideModel? activeRide =
                activeRideSnapshot.data;

            final bool hasActiveRide =
                activeRide != null;

            _scheduleGpsSync(
              isOnline: isOnline,
              activeRideId: activeRide?.rideId,
            );

            return Scaffold(
              backgroundColor: background,
              appBar: AppBar(
                backgroundColor: background,
                elevation: 0,
                title: const Text(
                  'Driver',
                  style: TextStyle(
                    color: Colors.white,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                actions: [
                  Padding(
                    padding:
                        const EdgeInsets.only(
                      right: 14,
                    ),
                    child: Center(
                      child: _statusBadge(
                        isOnline: isOnline,
                        isAvailable: isAvailable,
                        hasActiveRide:
                            hasActiveRide,
                      ),
                    ),
                  ),
                ],
              ),
              body: SafeArea(
                child: RefreshIndicator(
                  color: yellow,
                  backgroundColor: darkCard,
                  onRefresh: () async {
                    await Future<void>.delayed(
                      const Duration(
                        milliseconds: 400,
                      ),
                    );

                    if (mounted) {
                      setState(() {});
                    }
                  },
                  child: ListView(
                    physics:
                        const AlwaysScrollableScrollPhysics(),
                    padding:
                        const EdgeInsets.fromLTRB(
                      16,
                      10,
                      16,
                      30,
                    ),
                    children: [
                      _buildWelcomeSection(
                        displayName,
                      ),
                      const SizedBox(height: 18),
                      _buildVehicleCard(
                        vehicleType:
                            displayVehicleType,
                        vehicleNumber:
                            displayVehicleNumber,
                        approvalStatus:
                            approvalStatus,
                      ),
                      const SizedBox(height: 16),

                      if (driverSnapshot.hasError)
                        _buildErrorNotice(
                          driverSnapshot.error,
                        ),

                      if (approvalStatus !=
                          'approved')
                        _buildApprovalNotice(
                          approvalBypassActive:
                              approvalBypassActive,
                        ),

                      if (approvalStatus !=
                          'approved')
                        const SizedBox(height: 16),

                      if (activeRideSnapshot.hasError)
                        _buildErrorNotice(
                          activeRideSnapshot.error,
                        ),

                      if (activeRideSnapshot.hasError)
                        const SizedBox(height: 16),

                      _buildOnlineControl(
                        isOnline: isOnline,
                        hasActiveRide:
                            hasActiveRide,
                      ),
                      const SizedBox(height: 16),

                      _buildAvailabilityCard(
                        isOnline: isOnline,
                        isAvailable: isAvailable,
                        hasActiveRide:
                            hasActiveRide,
                      ),
                      const SizedBox(height: 16),

                      _buildGpsStatusCard(
                        isOnline: isOnline,
                      ),
                      const SizedBox(height: 16),

                      if (activeRide != null) ...[
                        _buildActiveRideCard(
                          activeRide,
                        ),
                        const SizedBox(height: 16),
                      ],

                      _buildRideRequestsCard(
                        isOnline: isOnline,
                        isAvailable: isAvailable,
                        hasActiveRide:
                            hasActiveRide,
                      ),
                      const SizedBox(height: 22),

                      _buildTodayStats(),
                      const SizedBox(height: 18),

                      _buildRideHistoryCard(),
                      const SizedBox(height: 18),

                      _buildWalletCard(),
                      const SizedBox(height: 18),

                      _buildRealConnectionNotice(),
                    ],
                  ),
                ),
              ),
            );
          },
        );
      },
    );
  }

