class _TrendPoint {
  final DateTime date;
  final double average;
  const _TrendPoint(this.date, this.average);
}

class _ServiceRow {
  final FeedbackServiceType type;
  final int count;
  final double average;
  const _ServiceRow({
    required this.type,
    required this.count,
    required this.average,
  });
}

class _CategoryCount {
  final String label;
  final int count;
  const _CategoryCount(this.label, this.count);
}

enum _AnalyticsRange {
  sevenDays(7, 'Last 7 days'),
  thirtyDays(30, 'Last 30 days'),
  ninetyDays(90, 'Last 90 days'),
  allTime(null, 'All time');

  final int? days;
  final String label;
  const _AnalyticsRange(this.days, this.label);
}

InputDecoration _input(String label, IconData icon) => InputDecoration(
  labelText: label,
  prefixIcon: Icon(icon),
  filled: true,
  fillColor: const Color(0xFFF5F6F7),
  isDense: true,
  border: OutlineInputBorder(
    borderRadius: BorderRadius.circular(13),
    borderSide: BorderSide.none,
  ),
);

BoxDecoration _decoration() => BoxDecoration(
  color: Colors.white,
  borderRadius: BorderRadius.circular(18),
  border: Border.all(color: const Color(0xFFE5E7EB)),
);

double _percent(int value, int total) => total == 0 ? 0 : value * 100 / total;

Color _starColor(int rating) {
  if (rating <= 2) return const Color(0xFFDC2626);
  if (rating == 3) return const Color(0xFFEA580C);
  return const Color(0xFF15803D);
}
