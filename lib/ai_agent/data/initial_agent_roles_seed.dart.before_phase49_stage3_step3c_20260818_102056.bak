// =========================================================
//
// Development/bootstrap helper only.
// Phase 2 Permission Engine will be DEFAULT-DENY.

List<AgentRole> buildInitialAgentRoles() {
  final DateTime now = DateTime.now();

  AgentRole role({
    required String roleId,
    required String name,
    required String description,
    required String module,
    required String mode,
    String aiClass = AiClass.freeAi,
    String privacyLevel = PrivacyLevel.internal,
    bool enabled = true,
    List<String> allowedActions = const <String>[],
    List<String> approvalRequiredActions = const <String>[],
    List<String> forbiddenActions = const <String>[],
  }) {
    return AgentRole(
      roleId: roleId,
      name: name,
      description: description,
      module: module,
      enabled: enabled,
      mode: mode,
      allowedActions: allowedActions,
      approvalRequiredActions: approvalRequiredActions,
      forbiddenActions: forbiddenActions,
      aiClass: aiClass,
      privacyLevel: privacyLevel,
      createdAt: now,
    );
  }

  return <AgentRole>[
    role(
      roleId: 'ride_agent',
      name: 'Ride Agent',
      description:
          'Reads exact ride details and operational status. '
          'Ride writes remain forbidden.',
      module: 'ride',
      mode: AgentMode.monitorOnly,
      allowedActions: const <String>[
        AgentActionId.readRide,
        AgentActionId.readRideStatus,
      ],
      forbiddenActions: const <String>[AgentActionId.cancelRide],
    ),
    role(
      roleId: 'driver_agent',
      name: 'Driver Agent',
      description:
          'Reads exact driver operational status and safe profile '
          'summary. Driver writes remain forbidden.',
      module: 'driver',
      mode: AgentMode.monitorOnly,
      allowedActions: const <String>[
        AgentActionId.readDriver,
        AgentActionId.readDriverStatus,
      ],
      forbiddenActions: const <String>[
        AgentActionId.approveDriver,
        AgentActionId.rejectDriver,
        AgentActionId.suspendDriver,
      ],
    ),
    role(
      roleId: 'food_agent',
      name: 'Food Agent',
      description:
          'Reads exact food order operational details and safe item '
          'summary. Customer identity, address, OTP, rider identity '
          'and GPS remain hidden. Food writes remain forbidden.',
      module: 'food',
      mode: AgentMode.monitorOnly,
      allowedActions: const <String>[AgentActionId.readFoodOrder],
      forbiddenActions: const <String>[AgentActionId.refundFoodOrder],
    ),
    role(
      roleId: 'restaurant_agent',
      name: 'Restaurant Agent',
      description:
          'Reads exact restaurant customer-facing operational details. '
          'Owner identity, contact details, exact location, private '
          'documents, commission and admin review data remain hidden. '
          'Restaurant writes remain forbidden.',
      module: 'restaurant',
      mode: AgentMode.monitorOnly,
      allowedActions: const <String>[AgentActionId.readRestaurant],
      forbiddenActions: const <String>[AgentActionId.suspendRestaurant],
    ),
    role(
      roleId: 'hotel_agent',
      name: 'Hotel Agent',
      description: 'Monitors hotel bookings and occupancy.',
      module: 'hotel',
      mode: AgentMode.monitorOnly,
    ),
    role(
      roleId: 'tour_agent',
      name: 'Tour Agent',
      description: 'Monitors tour bookings and availability.',
      module: 'tour',
      mode: AgentMode.monitorOnly,
    ),
    role(
      roleId: 'rewards_agent',
      name: 'Rewards Agent',
      description: 'Monitors points, coupons and cashback usage.',
      module: 'rewards',
      mode: AgentMode.monitorOnly,
    ),
    role(
      roleId: 'feedback_agent',
      name: 'Feedback Agent',
      description: 'Classifies, summarizes and drafts feedback/review replies.',
      module: 'feedback',
      mode: AgentMode.suggestOnly,
      allowedActions: const <String>[
        AgentActionId.readFeedback,
        AgentActionId.classifyFeedback,
        AgentActionId.draftFeedbackReply,
      ],
      approvalRequiredActions: const <String>[AgentActionId.sendFeedbackReply],
    ),
    role(
      roleId: 'support_agent',
      name: 'Support Agent',
      description:
          'Drafts routine support/FAQ responses; escalates sensitive issues.',
      module: 'support',
      mode: AgentMode.suggestOnly,
      allowedActions: const <String>[
        AgentActionId.readSupportCase,
        AgentActionId.draftSupportReply,
      ],
      approvalRequiredActions: const <String>[AgentActionId.sendSupportReply],
    ),
    role(
      roleId: 'email_agent',
      name: 'Email Agent',
      description:
          'Builds evidence-grounded email drafts and may request approval for one exact future send.',
      module: 'email',
      mode: AgentMode.suggestOnly,
      allowedActions: const <String>[AgentActionId.sendEmail],
      approvalRequiredActions: const <String>[AgentActionId.sendEmail],
    ),
    role(
      roleId: 'customer_whatsapp_agent',
      name: 'Customer WhatsApp Agent',
      description:
          'Customer-facing WhatsApp assistant. Reads only verified backend facts; any business write stays approval/runtime gated.',
      module: 'customer_whatsapp',
      mode: AgentMode.suggestOnly,
      privacyLevel: PrivacyLevel.private,
      allowedActions: const <String>[
        AgentActionId.readCustomerWhatsAppVerifiedData,
        AgentActionId.requestCustomerWhatsAppBusinessAction,
      ],
      approvalRequiredActions: const <String>[
        AgentActionId.requestCustomerWhatsAppBusinessAction,
      ],
    ),
    role(
      roleId: 'owner_whatsapp_agent',
      name: 'Owner WhatsApp Agent',
      description:
          'Privileged Owner/Super Admin WhatsApp assistant. Reads only verified reports; consequential requests require strong re-auth plus central approval/runtime/audit.',
      module: 'owner_whatsapp',
      mode: AgentMode.suggestOnly,
      privacyLevel: PrivacyLevel.highlySensitive,
      allowedActions: const <String>[
        AgentActionId.readOwnerWhatsAppVerifiedReport,
        AgentActionId.requestOwnerWhatsAppConsequentialAction,
      ],
      approvalRequiredActions: const <String>[
        AgentActionId.requestOwnerWhatsAppConsequentialAction,
      ],
    ),
    role(
      roleId: 'emergency_whatsapp_agent',
      name: 'Emergency WhatsApp Agent',
      description:
          'Emergency-only WhatsApp assistant. Reads verified privacy-minimized safety status and may request, but never directly execute, an approval-gated emergency escalation.',
      module: 'emergency_whatsapp',
      mode: AgentMode.suggestOnly,
      privacyLevel: PrivacyLevel.highlySensitive,
      allowedActions: const <String>[
        AgentActionId.readEmergencyWhatsAppVerifiedSafety,
        AgentActionId.requestEmergencyWhatsAppEscalation,
      ],
      approvalRequiredActions: const <String>[
        AgentActionId.requestEmergencyWhatsAppEscalation,
      ],
    ),
    role(
      roleId: 'voice_super_admin_agent',
      name: 'Voice Super Admin',
      description:
          'Owner/Super Admin whole-ecosystem assistant. Initial authority is READ + REPORT + EXPLAIN only through verified sanitized sources.',
      module: 'voice_super_admin',
      mode: AgentMode.monitorOnly,
      privacyLevel: PrivacyLevel.highlySensitive,
      allowedActions: const <String>[
        AgentActionId.readVoiceSuperAdminVerifiedReport,
      ],
    ),
    role(
      roleId: 'reports_agent',
      name: 'Reports Agent',
      description: 'Builds read-only owner/system reports from connected data.',
      module: 'reports',
      mode: AgentMode.monitorOnly,
      allowedActions: const <String>[
        AgentActionId.readSystemHealth,
        AgentActionId.readDailySummary,
        AgentActionId.readAdminIntelligenceReport,
      ],
    ),
    role(
      roleId: 'safety_agent',
      name: 'Safety Agent',
      description: 'Monitors SOS/emergency alerts. Alert + assist only.',
      module: 'safety',
      mode: AgentMode.monitorOnly,
      privacyLevel: PrivacyLevel.private,
    ),
    role(
      roleId: 'call_agent',
      name: 'Call Agent',
      description: 'Handles inbound call conversations for booking/support.',
