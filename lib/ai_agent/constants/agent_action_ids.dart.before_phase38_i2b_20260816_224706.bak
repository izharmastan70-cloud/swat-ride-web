// =========================================================
// AI AGENT â€” ACTION IDS
// =========================================================
//
// Stable IDs used by the Permission Engine.
// Phase 2 is DEFAULT-DENY: an unknown action ID is always denied.

class AgentActionId {
  AgentActionId._();

  // Shared / core
  static const String readSystemHealth = 'core.read_system_health';
  static const String readDailySummary = 'core.read_daily_summary';
  static const String createSuggestion = 'core.create_suggestion';

  // Website / SEO / controlled update
  static const String readWebsiteHealth = 'website.read_health';

  static const String proposeWebsiteChange = 'website.propose_change';

  static const String requestWebsitePreview = 'website.request_preview';

  static const String deployWebsiteProduction = 'website.deploy_production';
  // Ride
  static const String readRide = 'ride.read';
  static const String readRideStatus = 'ride.read_status';
  static const String cancelRide = 'ride.cancel';

  // Driver
  static const String readDriver = 'driver.read';
  static const String readDriverStatus = 'driver.read_status';
  static const String approveDriver = 'driver.approve';
  static const String rejectDriver = 'driver.reject';
  static const String suspendDriver = 'driver.suspend';

  // Food / restaurant
  static const String readFoodOrder = 'food.read_order';
  static const String readRestaurant = 'food.read_restaurant';
  static const String suspendRestaurant = 'food.suspend_restaurant';
  static const String refundFoodOrder = 'food.refund_order';

  // Hotel
  static const String readHotelBooking = 'hotel.read_booking';
  static const String cancelHotelBooking = 'hotel.cancel_booking';
  static const String changeHotelPrice = 'hotel.change_price';

  // Tour
  static const String readTourBooking = 'tour.read_booking';
  static const String cancelTourBooking = 'tour.cancel_booking';
  static const String changeTourPrice = 'tour.change_price';

  // Rewards
  static const String readRewards = 'rewards.read';
  static const String adjustRewardBalance = 'rewards.adjust_balance';

  // Feedback / support
  static const String readFeedback = 'feedback.read';
  static const String classifyFeedback = 'feedback.classify';
  static const String draftFeedbackReply = 'feedback.draft_reply';
  static const String sendFeedbackReply = 'feedback.send_reply';
  static const String readSupportCase = 'support.read_case';
  static const String draftSupportReply = 'support.draft_reply';
  static const String sendSupportReply = 'support.send_reply';

  // Safety
  static const String readSafetyAlert = 'safety.read_alert';
  static const String sendSafetyAlert = 'safety.send_alert';

  // Calls
  static const String readCallSession = 'call.read_session';
  static const String draftCallResponse = 'call.draft_response';
  static const String transferCallToHuman = 'call.transfer_human';
  static const String transferCallToManager = 'call.transfer_manager';
  static const String transferCallToOwner = 'call.transfer_owner';

  // Crash / code
  static const String readCrashLog = 'crash.read_log';
  static const String classifyCrash = 'crash.classify';
  static const String handoffCrashToCodeAgent = 'crash.handoff_to_code';
  static const String readCode = 'code.read';
  static const String analyzeCodeError = 'code.analyze_error';
  static const String prepareCodeFix = 'code.prepare_fix';
  static const String modifyCode = 'code.modify';
  static const String deployCode = 'code.deploy';

  // Finance
  static const String readFinanceSummary = 'finance.read_summary';
  static const String prepareSettlement = 'finance.prepare_settlement';
  static const String executeRefund = 'finance.execute_refund';
  static const String approveWithdrawal = 'finance.approve_withdrawal';

  // Cargo â€” defined now, connector remains OFF until module is built.
  static const String readCargoBooking = 'cargo.read_booking';
  static const String readCargoStatus = 'cargo.read_status';
  static const String cancelCargoBooking = 'cargo.cancel_booking';

  // Student Ride â€” defined now, connector remains OFF until module + safety are ready.
  static const String readStudentRide = 'student.read_ride';
  static const String readStudentAttendance = 'student.read_attendance';
  static const String readStudentSafety = 'student.read_safety';
  static const String changeGuardian = 'student.change_guardian';
  static const String overrideStudentSafety = 'student.override_safety';

  static const Set<String> values = <String>{
    readSystemHealth,
    readDailySummary,
    createSuggestion,
    readWebsiteHealth,
    proposeWebsiteChange,
    requestWebsitePreview,
    deployWebsiteProduction,
    readRide,
    readRideStatus,
    cancelRide,
    readDriver,
    readDriverStatus,
    approveDriver,
    rejectDriver,
    suspendDriver,
    readFoodOrder,
    readRestaurant,
    suspendRestaurant,
    refundFoodOrder,
    readHotelBooking,
    cancelHotelBooking,
    changeHotelPrice,
    readTourBooking,
    cancelTourBooking,
    changeTourPrice,
    readRewards,
    adjustRewardBalance,
    readFeedback,
    classifyFeedback,
    draftFeedbackReply,
    sendFeedbackReply,
    readSupportCase,
    draftSupportReply,
    sendSupportReply,
    readSafetyAlert,
    sendSafetyAlert,
    readCallSession,
    draftCallResponse,
    transferCallToHuman,
    transferCallToManager,
    transferCallToOwner,
    readCrashLog,
    classifyCrash,
    handoffCrashToCodeAgent,
    readCode,
    analyzeCodeError,
    prepareCodeFix,
    modifyCode,
    deployCode,
    readFinanceSummary,
    prepareSettlement,
    executeRefund,
    approveWithdrawal,
    readCargoBooking,
    readCargoStatus,
    cancelCargoBooking,
    readStudentRide,
    readStudentAttendance,
    readStudentSafety,
    changeGuardian,
    overrideStudentSafety,
  };

  static bool isKnown(String actionId) => values.contains(actionId);
}
