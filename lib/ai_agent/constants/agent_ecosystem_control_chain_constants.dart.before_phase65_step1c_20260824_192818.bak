class AgentEcosystemControlActor {
  AgentEcosystemControlActor._();

  static const String customer = 'CUSTOMER';
  static const String owner = 'OWNER';
  static const String admin = 'ADMIN';
  static const String agent = 'AGENT';

  static const Set<String> values = <String>{customer, owner, admin, agent};
}

class AgentEcosystemControlDecisionStatus {
  AgentEcosystemControlDecisionStatus._();

  static const String blockEmergencyStop = 'BLOCK_EMERGENCY_STOP';
  static const String blockModuleDisabled = 'BLOCK_MODULE_DISABLED';
