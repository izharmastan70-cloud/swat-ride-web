    blockModuleDisabled,
    blockUntrustedPrivilegedIdentity,
    blockSubjectMismatch,
    blockPermissionDenied,
    blockSelfPermissionEscalation,
    blockApprovalMissing,
    blockApprovalExpired,
    blockApprovalBindingMismatch,
