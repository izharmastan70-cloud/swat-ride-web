      'BLOCK_UNTRUSTED_PRIVILEGED_IDENTITY';
  static const String blockSubjectMismatch = 'BLOCK_SUBJECT_MISMATCH';
  static const String blockPermissionDenied = 'BLOCK_PERMISSION_DENIED';
