            const SizedBox(height: 12),
            Card(
              child: Padding(
                padding: const EdgeInsets.all(16),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: <Widget>[
                    const Text(
                      'Prepared live review',
                      style: TextStyle(fontWeight: FontWeight.bold),
                    ),
                    const SizedBox(height: 8),
                    _row('Access', prepared.accessSourceLabel),
                    _row('Roles', prepared.roleCount.toString()),
                    _row(
                      'Actor SHA',
                      _shortHash(prepared.actorReferenceSha256),
                    ),
                    _row(
                      'Snapshot SHA',
                      _shortHash(prepared.snapshotFingerprintSha256),
                    ),
                    _row(
                      'Control SHA',
                      _shortHash(prepared.controlStateFingerprintSha256),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 12),
            FilledButton.icon(
              onPressed: _working ? null : _confirmAndActivate,
              icon: const Icon(Icons.rocket_launch_outlined),
              label: const Text('APPROVE & ACTIVATE MONITOR_ONLY'),
            ),
          ],
          if (outcome != null) ...<Widget>[
            const SizedBox(height: 12),
            Card(
              child: Padding(
                padding: const EdgeInsets.all(16),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: <Widget>[
                    Text(
                      outcome.monitorOnlyProductionActive
                          ? 'VERIFIED ACTIVE'
                          : 'NOT VERIFIED ACTIVE',
                      style: TextStyle(
                        fontWeight: FontWeight.bold,
                        color: outcome.monitorOnlyProductionActive
                            ? Colors.green
                            : Colors.red,
                      ),
                    ),
                    const SizedBox(height: 8),
                    _row('Status', outcome.status),
                    _row('Reason', outcome.reasonCode),
                    _row('Guard revision', outcome.guardRevision.toString()),
                    _row('Activation ID', _shortHash(outcome.activationId)),
                    _row('Token SHA', _shortHash(outcome.armingTokenIdSha256)),
                    _row('AUTO traffic', '0%'),
                    _row('Business writes', '0%'),
                    _row('External channels', 'OFF'),
                  ],
                ),
              ),
            ),
          ],
        ],
      ),
    );
  }

  Widget _row(String label, String value) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 6),
      child: Text('$label: $value'),
    );
  }

  String _shortHash(String value) {
    final String clean = value.trim();
    if (clean.length <= 16) return clean;
    return '${clean.substring(0, 8)}ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¦${clean.substring(clean.length - 8)}';
  }
}
