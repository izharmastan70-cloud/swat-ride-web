class AgentProductionRolloutMonitorActivationScreen extends StatefulWidget {
  const AgentProductionRolloutMonitorActivationScreen({
    super.key,
    required this.currentAdminId,
  });

  final String currentAdminId;

  @override
  State<AgentProductionRolloutMonitorActivationScreen> createState() =>
      _AgentProductionRolloutMonitorActivationScreenState();
}

class _AgentProductionRolloutMonitorActivationScreenState
    extends State<AgentProductionRolloutMonitorActivationScreen> {
  final AgentProductionRolloutStep1GLiveActivationCoordinator _coordinator =
      AgentProductionRolloutStep1GLiveActivationCoordinator();

  AgentProductionRolloutStep1GPreparedReview? _prepared;
  AgentProductionRolloutStep1GActivationOutcome? _outcome;

  bool _working = false;
  String _message = 'No live production action has been prepared yet.';

  Future<void> _initializeSafeMasterBaseline() async {
    if (_working) return;

    final bool confirmed =
        await showDialog<bool>(
          context: context,
          barrierDismissible: false,
          builder: (BuildContext dialogContext) {
            return AlertDialog(
              title: const Text('Initialize safe AI master baseline?'),
              content: const Text(
                'This creates agent_settings/master only if it is missing, '
                'using the existing fail-closed safe defaults. '
                'It does NOT activate MONITOR_ONLY, AUTO, paid/local AI, '
                'Call, Email or WhatsApp.',
              ),
              actions: <Widget>[
                TextButton(
                  onPressed: () {
                    Navigator.of(dialogContext).pop(false);
                  },
                  child: const Text('CANCEL'),
                ),
                FilledButton(
                  onPressed: () {
                    Navigator.of(dialogContext).pop(true);
                  },
                  child: const Text('INITIALIZE SAFE BASELINE'),
                ),
              ],
            );
          },
        ) ??
        false;

    if (!mounted || !confirmed) {
      return;
    }

    setState(() {
      _working = true;
      _prepared = null;
      _outcome = null;
      _message =
          'Creating the fail-closed AI master document only if it is missing...';
    });

    try {
      await AgentMasterSettingsService().bootstrapSafeDefaults(
        actorId: widget.currentAdminId,
      );

      if (!mounted) return;

      setState(() {
        _prepared = null;
        _outcome = null;
        _message =
            'Safe AI master baseline is present. '
            'Press READ LIVE STATE / PREPARE REVIEW again before activation.';
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _prepared = null;
        _outcome = null;
        _message = _friendlyError(error);
      });
    } finally {
      if (mounted) {
        setState(() {
          _working = false;
        });
      }
    }
  }

  Future<void> _prepare() async {
    if (_working) return;

    setState(() {
      _working = true;
      _message = 'Reading current production control state...';
      _outcome = null;
    });

    try {
      final AgentProductionRolloutStep1GPreparedReview review =
          await _coordinator.prepare(currentAdminId: widget.currentAdminId);

      if (!mounted) return;

      setState(() {
        _prepared = review;
        _message =
            'Live OFF baseline verified. Review the hashes and role count '
            'before explicit MONITOR_ONLY approval.';
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _prepared = null;
        _message = _friendlyError(error);
      });
    } finally {
      if (mounted) {
        setState(() {
          _working = false;
        });
      }
    }
  }

  Future<void> _confirmAndActivate() async {
    final AgentProductionRolloutStep1GPreparedReview? prepared = _prepared;

    if (_working || prepared == null) return;

    final TextEditingController controller = TextEditingController();

    final bool confirmed =
        await showDialog<bool>(
          context: context,
          barrierDismissible: false,
          builder: (BuildContext dialogContext) {
            return AlertDialog(
              title: const Text('Activate production MONITOR_ONLY?'),
              content: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: <Widget>[
                  const Text(
                    'This is a real production control-plane change. '
                    'AUTO traffic and business writes remain 0%. '
                    'Paid AI, Local AI, Call, Email and WhatsApp '
                    'remain disabled.',
                  ),
                  const SizedBox(height: 12),
                  const Text(
                    'Type MONITOR_ONLY to approve:',
                    style: TextStyle(fontWeight: FontWeight.bold),
                  ),
                  const SizedBox(height: 8),
                  TextField(
                    controller: controller,
                    autofocus: true,
                    decoration: const InputDecoration(
                      border: OutlineInputBorder(),
                      hintText: 'MONITOR_ONLY',
                    ),
                  ),
                ],
              ),
              actions: <Widget>[
                TextButton(
                  onPressed: () {
                    Navigator.of(dialogContext).pop(false);
                  },
                  child: const Text('CANCEL'),
                ),
                FilledButton(
                  onPressed: () {
                    final bool exact =
                        controller.text.trim() ==
                        AgentProductionRolloutStep1GEvidence.confirmationPhrase;

                    Navigator.of(dialogContext).pop(exact);
                  },
                  child: const Text('APPROVE'),
                ),
              ],
            );
          },
        ) ??
        false;

    controller.dispose();

    if (!mounted || !confirmed) {
      return;
    }

    setState(() {
      _working = true;
      _message =
          'Running fresh preflight, guard binding, one-time token, '
          'atomic activation and immediate verification...';
      _outcome = null;
    });

    try {
      final AgentProductionRolloutStep1GActivationOutcome outcome =
          await _coordinator.approveAndActivate(
            currentAdminId: widget.currentAdminId,
            prepared: prepared,
          );

      if (!mounted) return;

      setState(() {
        _outcome = outcome;
        _message = outcome.monitorOnlyProductionActive
            ? 'MONITOR_ONLY is production-active and immediate '
                  'verification passed.'
            : outcome.activated
            ? 'CRITICAL: Activation committed but post-verification '
                  'did not pass. Use the existing AI Emergency Stop '
                  'and review the control plane.'
            : 'Activation was blocked safely: '
                  '${outcome.reasonCode}';
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _outcome = null;
        _message = _friendlyError(error);
      });
    } finally {
      if (mounted) {
        setState(() {
          _working = false;
        });
      }
    }
  }

  String _friendlyError(Object error) {
    final String raw = error.toString();

    if (raw.contains(
      'fresh_login_required_sign_out_and_sign_in_again_with_normal_otp',
    )) {
      return 'Fresh Super Admin login required. Sign out, sign in '
          'again using the normal OTP flow, then return here. '
          'Token refresh alone does not count as re-authentication.';
    }

    if (raw.contains(
      'firebase_super_admin_custom_claim_required_for_production_rollout',
    )) {
      return 'Production rollout requires the Firebase '
          'role=super_admin custom claim. A Firestore-only Admin '
          'record is intentionally not enough for this critical action.';
    }

    return raw.replaceFirst('Bad state: ', '');
  }

