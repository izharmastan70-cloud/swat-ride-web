import 'package:flutter/material.dart';
import 'package:url_launcher/url_launcher.dart';

import '../models/help_video_tutorial_model.dart';
import '../services/help_video_tutorial_service.dart';

class VideoTutorialsScreen extends StatelessWidget {
  VideoTutorialsScreen({super.key, HelpVideoTutorialService? service})
    : _service = service ?? HelpVideoTutorialService();

  static const Color _yellow = Color(0xFFFFD60A);

  final HelpVideoTutorialService _service;

  Future<void> _openTutorial(
    BuildContext context,
    HelpVideoTutorialModel tutorial,
  ) async {
    if (!_service.isSafeVideoUrl(tutorial.videoUrl)) {
      _showMessage(context, 'This tutorial link is not valid.');
      return;
    }

    final Uri? uri = Uri.tryParse(tutorial.videoUrl.trim());

    if (uri == null) {
      _showMessage(context, 'This tutorial link is not valid.');
      return;
    }

    try {
      final bool opened = await launchUrl(
        uri,
        mode: LaunchMode.externalApplication,
      );

      if (!opened && context.mounted) {
        _showMessage(context, 'The video could not be opened.');
      }
    } on Object {
      if (context.mounted) {
        _showMessage(context, 'The video could not be opened.');
      }
    }
  }

  void _showMessage(BuildContext context, String message) {
    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(SnackBar(content: Text(message)));
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF0D0D0D),
      appBar: AppBar(
        backgroundColor: const Color(0xFF0D0D0D),
        title: const Text(
          'Video Tutorials',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
      ),
      body: SafeArea(
        child: StreamBuilder<List<HelpVideoTutorialModel>>(
          stream: _service.watchEnabledTutorials(),
          builder:
              (
                BuildContext context,
                AsyncSnapshot<List<HelpVideoTutorialModel>> snapshot,
              ) {
                if (snapshot.connectionState == ConnectionState.waiting &&
                    !snapshot.hasData) {
                  return const Center(child: CircularProgressIndicator());
                }

                if (snapshot.hasError) {
                  return const _TutorialStateView(
                    icon: Icons.video_library_outlined,
                    title: 'Tutorials are unavailable',
                    message:
                        'Video tutorials are not available right now. Please try again later.',
                  );
                }

                final List<HelpVideoTutorialModel> tutorials =
                    snapshot.data ?? const <HelpVideoTutorialModel>[];

                if (tutorials.isEmpty) {
                  return const _TutorialStateView(
                    icon: Icons.ondemand_video_outlined,
                    title: 'No tutorials available yet',
                    message:
                        'SWAT RIDE video guides will appear here when they are published.',
                  );
                }

                return ListView.separated(
                  padding: const EdgeInsets.all(16),
                  itemCount: tutorials.length,
                  separatorBuilder: (BuildContext context, int index) =>
                      const SizedBox(height: 12),
                  itemBuilder: (BuildContext context, int index) {
                    final HelpVideoTutorialModel tutorial = tutorials[index];

                    return _TutorialCard(
                      tutorial: tutorial,
                      onTap: () => _openTutorial(context, tutorial),
                    );
                  },
                );
              },
        ),
      ),
    );
  }
}

class _TutorialCard extends StatelessWidget {
  const _TutorialCard({required this.tutorial, required this.onTap});

  final HelpVideoTutorialModel tutorial;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return Material(
      color: const Color(0xFF181818),
      borderRadius: BorderRadius.circular(16),
      child: InkWell(
        borderRadius: BorderRadius.circular(16),
        onTap: onTap,
        child: Padding(
          padding: const EdgeInsets.all(16),
          child: Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: <Widget>[
              Container(
                width: 52,
                height: 52,
                decoration: BoxDecoration(
                  color: const Color(0xFFFFD60A),
                  borderRadius: BorderRadius.circular(14),
                ),
                child: const Icon(
                  Icons.play_arrow_rounded,
                  color: Colors.black,
                  size: 30,
                ),
              ),
              const SizedBox(width: 14),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: <Widget>[
                    Text(
                      tutorial.title,
                      style: const TextStyle(
                        color: Colors.white,
                        fontWeight: FontWeight.w700,
                        fontSize: 16,
                      ),
                    ),
                    if (tutorial.description.trim().isNotEmpty) ...<Widget>[
                      const SizedBox(height: 6),
                      Text(
                        tutorial.description,
                        maxLines: 3,
                        overflow: TextOverflow.ellipsis,
                        style: const TextStyle(
                          color: Colors.white60,
                          height: 1.35,
                        ),
                      ),
                    ],
                    const SizedBox(height: 8),
                    Text(
                      tutorial.category.trim().isEmpty
                          ? 'General'
                          : tutorial.category,
                      style: const TextStyle(
                        color: Colors.white38,
                        fontSize: 12,
                      ),
                    ),
                  ],
                ),
              ),
              const SizedBox(width: 8),
              const Icon(Icons.open_in_new_rounded, color: Colors.white54),
            ],
          ),
        ),
      ),
    );
  }
}

class _TutorialStateView extends StatelessWidget {
  const _TutorialStateView({
    required this.icon,
    required this.title,
    required this.message,
  });

  final IconData icon;
  final String title;
  final String message;

  @override
  Widget build(BuildContext context) {
    return Center(
      child: Padding(
        padding: const EdgeInsets.all(28),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: <Widget>[
            Icon(icon, color: const Color(0xFFFFD60A), size: 58),
            const SizedBox(height: 16),
            Text(
              title,
              textAlign: TextAlign.center,
              style: const TextStyle(
                color: Colors.white,
                fontWeight: FontWeight.bold,
                fontSize: 19,
              ),
            ),
            const SizedBox(height: 8),
            Text(
              message,
              textAlign: TextAlign.center,
              style: const TextStyle(color: Colors.white60, height: 1.4),
            ),
          ],
        ),
      ),
    );
  }
}
