                child: Icon(
                  completed
                      ? Icons.check_rounded
                      : noDriver
                          ? Icons.search_off_rounded
                          : Icons.close_rounded,
                  size: 54,
                  color: completed
                      ? const Color(0xFF087F5B)
                      : Colors.redAccent,
