  bool _shouldShowRidePin(RideModel ride) {
    return ride.hasDriver &&
        ride.hasRideStartPin &&
        !ride.rideStartPinVerified &&
        <String>{
          RideModel.driverAssigned,
          RideModel.driverArriving,
          RideModel.driverArrived,
        }.contains(ride.status);
  }

