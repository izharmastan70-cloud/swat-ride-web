  Future<void> _openRatingDialog(RideModel ride) async {
    if (_isSubmittingRating || _ratingSubmitted) return;

    try {
      if (await _ratingService.hasRatedRide(ride.rideId)) {
        if (mounted) {
          setState(() => _ratingSubmitted = true);
          ScaffoldMessenger.of(context).showSnackBar(
            const SnackBar(content: Text('You already rated this ride.')),
          );
        }
        return;
      }
    } catch (_) {
      // Submission transaction will perform the final duplicate check.
    }

    if (!mounted) return;

    final TextEditingController commentController =
        TextEditingController();
    int selectedStars = 0;
    final Set<String> selectedTags = <String>{};

    const List<String> availableTags = <String>[
      'Safe driving',
      'Polite driver',
      'Clean vehicle',
      'On time',
      'Smooth ride',
      'Good route',
    ];

    final _RideRatingInput? input = await showDialog<_RideRatingInput>(
      context: context,
      barrierDismissible: false,
      builder: (BuildContext dialogContext) {
        return StatefulBuilder(
          builder: (
            BuildContext context,
            void Function(void Function()) setDialogState,
          ) {
            return AlertDialog(
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(22),
              ),
              title: const Text(
                'How was your ride?',
                textAlign: TextAlign.center,
                style: TextStyle(fontWeight: FontWeight.w900),
              ),
              content: SingleChildScrollView(
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: <Widget>[
                    Text(
                      'Rate ${ride.driverName ?? 'your Driver'}',
                      textAlign: TextAlign.center,
                      style: const TextStyle(color: Colors.black54),
                    ),
                    const SizedBox(height: 17),
                    Row(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: List<Widget>.generate(5, (int index) {
                        final int star = index + 1;
                        return IconButton(
                          tooltip: '$star star',
                          onPressed: () {
                            setDialogState(() => selectedStars = star);
                          },
                          iconSize: 39,
                          padding: const EdgeInsets.symmetric(horizontal: 2),
                          icon: Icon(
                            star <= selectedStars
                                ? Icons.star_rounded
                                : Icons.star_border_rounded,
                            color: const Color(0xFFFFB000),
                          ),
                        );
                      }),
                    ),
                    const SizedBox(height: 13),
                    Wrap(
                      spacing: 7,
                      runSpacing: 7,
                      alignment: WrapAlignment.center,
                      children: availableTags.map((String tag) {
                        final bool selected = selectedTags.contains(tag);
                        return FilterChip(
                          label: Text(tag),
                          selected: selected,
                          selectedColor: const Color(0xFFDDF5EB),
                          checkmarkColor: const Color(0xFF087F5B),
                          onSelected: (bool value) {
                            setDialogState(() {
                              if (value) {
                                selectedTags.add(tag);
                              } else {
                                selectedTags.remove(tag);
                              }
                            });
                          },
                        );
                      }).toList(growable: false),
                    ),
                    const SizedBox(height: 16),
                    TextField(
                      controller: commentController,
                      maxLength: 500,
                      maxLines: 3,
                      decoration: InputDecoration(
                        hintText: 'Add feedback (optional)',
                        filled: true,
                        fillColor: const Color(0xFFF4F5F7),
                        border: OutlineInputBorder(
                          borderRadius: BorderRadius.circular(14),
                          borderSide: BorderSide.none,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
              actions: <Widget>[
                TextButton(
                  onPressed: () => Navigator.pop(dialogContext),
                  child: const Text('Later'),
                ),
                FilledButton(
                  onPressed: selectedStars == 0
                      ? null
                      : () {
                          Navigator.pop(
                            dialogContext,
                            _RideRatingInput(
                              stars: selectedStars,
                              comment: commentController.text,
                              tags: selectedTags.toList(growable: false),
                            ),
                          );
                        },
                  style: FilledButton.styleFrom(
                    backgroundColor: const Color(0xFF087F5B),
                  ),
                  child: const Text('Submit rating'),
                ),
              ],
            );
          },
        );
      },
    );

    commentController.dispose();

    if (input == null || !mounted) return;
    setState(() => _isSubmittingRating = true);

    try {
      await _ratingService.submitDriverRating(
        rideId: ride.rideId,
        stars: input.stars,
        comment: input.comment,
        tags: input.tags,
      );

      if (!mounted) return;
      setState(() => _ratingSubmitted = true);
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Thank you! Your rating was submitted.'),
          backgroundColor: Color(0xFF087F5B),
        ),
      );
    } catch (error) {
      if (!mounted) return;

      final String message = _friendlyError(error);
      if (message.toLowerCase().contains('already rated')) {
        setState(() => _ratingSubmitted = true);
      }
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text(message), backgroundColor: Colors.redAccent),
      );
    } finally {
      if (mounted) setState(() => _isSubmittingRating = false);
    }
  }

