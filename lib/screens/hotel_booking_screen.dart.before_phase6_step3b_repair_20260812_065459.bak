                  ),
                ),
              ),
            ],
          ),
          content:
              SingleChildScrollView(
            child: Column(
              mainAxisSize:
                  MainAxisSize.min,
              crossAxisAlignment:
                  CrossAxisAlignment.start,
              children: [
                _dialogRow(
                  'Booking ID',
                  bookingId,
                ),
                _dialogRow(
                  'Hotel',
                  hotelName,
                ),
                _dialogRow(
                  'Room',
                  roomName,
                ),
                _dialogRow(
                  'Guest',
                  guestNameController
                      .text
                      .trim(),
                ),
                _dialogRow(
                  'Stay',
                  '$totalNights night(s)',
                ),
                _dialogRow(
