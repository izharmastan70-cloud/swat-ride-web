              textAlign: TextAlign.right,
              style: const TextStyle(
                color: Colors.white,
                fontSize: 12,
                fontWeight: FontWeight.bold,
              ),
            ),
          ),
        ],
      ),
    );
  }

  List<QueryDocumentSnapshot<Map<String, dynamic>>>
      _filterBookings(
    List<QueryDocumentSnapshot<
            Map<String, dynamic>>>
        documents,
  ) {
    final String search =
        _searchText.trim().toLowerCase();
    final DateTime now = DateTime.now();

    return documents.where((document) {
      final data = document.data();
      final String status =
          data['bookingStatus']?.toString() ??
              'pending';
      final DateTime checkIn =
          _readDateTime(data['checkIn']);
      final String hotelName =
          data['hotelName']
                  ?.toString()
                  .toLowerCase() ??
              '';
      final String roomName =
          data['roomName']
                  ?.toString()
                  .toLowerCase() ??
              data['roomType']
                  ?.toString()
                  .toLowerCase() ??
              '';
      final String bookingId =
          (data['bookingId'] ?? document.id)
              .toString()
              .toLowerCase();

      final bool searchMatch =
          search.isEmpty ||
              hotelName.contains(search) ||
              roomName.contains(search) ||
              bookingId.contains(search);

      bool filterMatch = true;

      if (_selectedFilter == 'active') {
        filterMatch = _isActive(status);
      } else if (_selectedFilter ==
          'upcoming') {
        filterMatch =
            _isUpcomingStatus(status) &&
                checkIn.isAfter(now);
      } else if (_selectedFilter ==
          'completed') {
        filterMatch =
            _isCompleted(status);
      } else if (_selectedFilter ==
          'cancelled') {
        filterMatch =
            status == 'cancelled' ||
                status == 'rejected';
      }

      return searchMatch && filterMatch;
    }).toList();
  }

  bool _isActive(String status) {
    return status == 'checked_in' ||
        status == 'active' ||
        status == 'in_stay';
  }

  bool _isUpcomingStatus(String status) {
    return status == 'pending' ||
        status ==
            'pending_hotel_confirmation' ||
        status == 'confirmed';
  }

  bool _isCompleted(String status) {
    return status == 'completed' ||
        status == 'checked_out';
  }

