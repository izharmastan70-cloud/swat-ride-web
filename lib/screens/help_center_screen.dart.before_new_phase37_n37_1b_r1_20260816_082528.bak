import 'package:flutter/material.dart';

import '../ai_agent/services/agent_support_faq_service.dart';

class HelpCenterScreen extends StatefulWidget {
  const HelpCenterScreen({super.key});

  @override
  State<HelpCenterScreen> createState() => _HelpCenterScreenState();
}

class _HelpCenterScreenState extends State<HelpCenterScreen> {
  static const Color _yellow = Color(0xFFFFD60A);

  final AgentSupportFaqService _faqService =
      const AgentSupportFaqService();

  final TextEditingController _questionController =
      TextEditingController();

  String _answer = '';
  bool _hasAskedQuestion = false;

  @override
  void dispose() {
    _questionController.dispose();
    super.dispose();
  }

  void _askQuestion() {
    final String question =
        _questionController.text.trim();

    if (question.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text(
            'Please type your question first.',
          ),
        ),
      );
      return;
    }

    final String answer =
        _faqService.answer(question);

    setState(() {
      _answer = answer;
      _hasAskedQuestion = true;
    });
  }

  void _showHumanSupportInfo() {
    showDialog<void>(
      context: context,
      builder: (BuildContext dialogContext) {
        return AlertDialog(
          title: const Text('Human Support'),
          content: const Text(
            'For payment disputes, refunds, account restrictions, '
            'safety matters or a complaint about a real booking/order, '
            'SWAT RIDE requires the relevant record to be verified by '
            'human/admin support.\n\n'
            'The existing complaint and module-specific support systems '
            'will be connected to this Help Center in the next support step. '
            'This screen does not create a duplicate support ticket.',
          ),
          actions: <Widget>[
            TextButton(
              onPressed: () =>
                  Navigator.of(dialogContext).pop(),
              child: const Text('OK'),
            ),
          ],
        );
      },
    );
  }

  void _showVideoTutorialInfo() {
    showDialog<void>(
      context: context,
      builder: (BuildContext dialogContext) {
        return AlertDialog(
          title: const Text('Video Tutorials'),
          content: const Text(
            'Video tutorials are part of the NEW Phase 37 roadmap. '
            'The Help Center entry is ready, but the managed video/tutorial '
            'catalog and playback/open-link layer will be connected in the '
            'dedicated Video System step.',
          ),
          actions: <Widget>[
            TextButton(
              onPressed: () =>
                  Navigator.of(dialogContext).pop(),
              child: const Text('OK'),
            ),
          ],
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF0D0D0D),
      appBar: AppBar(
        backgroundColor: const Color(0xFF0D0D0D),
        title: const Text(
          'Help & Support',
          style: TextStyle(
            fontWeight: FontWeight.bold,
          ),
        ),
      ),
      body: SafeArea(
        child: ListView(
          padding: const EdgeInsets.all(16),
          children: <Widget>[
            _buildHeader(),
            const SizedBox(height: 16),
            _buildAskSupportCard(),
            const SizedBox(height: 16),
            _buildQuickHelpSection(),
            const SizedBox(height: 16),
            _buildSupportActions(),
            const SizedBox(height: 20),
            const Text(
              'SWAT RIDE Help Center gives general guidance only. '
              'Real booking, payment, refund, safety and account records '
              'must be verified by the relevant module or human support.',
              style: TextStyle(
                color: Colors.white54,
                fontSize: 12,
                height: 1.4,
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildHeader() {
    return Container(
      padding: const EdgeInsets.all(18),
      decoration: BoxDecoration(
        color: const Color(0xFF1A1A1A),
        borderRadius: BorderRadius.circular(18),
        border: Border.all(
          color: _yellow.withValues(alpha: 0.35),
        ),
      ),
      child: const Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: <Widget>[
          CircleAvatar(
            backgroundColor: _yellow,
            child: Icon(
              Icons.support_agent,
              color: Colors.black,
            ),
          ),
          SizedBox(width: 14),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: <Widget>[
                Text(
                  'How can we help?',
                  style: TextStyle(
                    color: Colors.white,
                    fontSize: 20,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                SizedBox(height: 5),
                Text(
                  'Get quick SWAT RIDE guidance or choose a support option.',
                  style: TextStyle(
                    color: Colors.white70,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildAskSupportCard() {
    return Card(
      color: const Color(0xFF181818),
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: <Widget>[
            const Row(
              children: <Widget>[
                Icon(
                  Icons.question_answer_outlined,
                  color: _yellow,
                ),
                SizedBox(width: 10),
                Text(
                  'Ask SWAT RIDE Help',
                  style: TextStyle(
                    color: Colors.white,
                    fontWeight: FontWeight.bold,
                    fontSize: 17,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 12),
            TextField(
              controller: _questionController,
              minLines: 1,
              maxLines: 4,
              textInputAction: TextInputAction.done,
              onSubmitted: (_) => _askQuestion(),
              decoration: const InputDecoration(
                labelText: 'Type your question',
                hintText:
                    'Example: How do I book a ride?',
                border: OutlineInputBorder(),
              ),
            ),
            const SizedBox(height: 12),
            SizedBox(
              width: double.infinity,
              child: ElevatedButton.icon(
                onPressed: _askQuestion,
                icon: const Icon(
                  Icons.auto_awesome_outlined,
                ),
                label: const Text(
                  'GET HELP',
                ),
              ),
            ),
            if (_hasAskedQuestion) ...<Widget>[
              const SizedBox(height: 14),
              Container(
                width: double.infinity,
                padding: const EdgeInsets.all(14),
                decoration: BoxDecoration(
                  color: const Color(0xFF101010),
                  borderRadius:
                      BorderRadius.circular(12),
                  border: Border.all(
                    color: Colors.white12,
                  ),
                ),
                child: Column(
                  crossAxisAlignment:
                      CrossAxisAlignment.start,
                  children: <Widget>[
                    const Text(
                      'SWAT RIDE Help',
                      style: TextStyle(
                        color: _yellow,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                    const SizedBox(height: 7),
                    Text(
                      _answer,
                      style: const TextStyle(
                        color: Colors.white70,
                        height: 1.45,
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ],
        ),
      ),
    );
  }

  Widget _buildQuickHelpSection() {
    return Card(
      color: const Color(0xFF181818),
      child: Padding(
        padding: const EdgeInsets.symmetric(
          vertical: 6,
        ),
        child: Column(
          children: <Widget>[
            _faqTile(
              icon: Icons.local_taxi_outlined,
              title: 'Rides',
              question: 'How do I book a ride?',
            ),
            _faqTile(
              icon: Icons.payments_outlined,
              title: 'Payments',
              question:
                  'What should I know about payment?',
            ),
            _faqTile(
              icon: Icons.hotel_outlined,
              title: 'Hotels',
              question:
                  'How can support help with hotel booking?',
            ),
            _faqTile(
              icon: Icons.travel_explore_outlined,
              title: 'Tours',
              question:
                  'How can support help with tours?',
            ),
            _faqTile(
              icon: Icons.support_agent,
              title: 'General Support',
              question:
                  'What can SWAT RIDE support help with?',
            ),
          ],
        ),
      ),
    );
  }

  Widget _faqTile({
    required IconData icon,
    required String title,
    required String question,
  }) {
    return ExpansionTile(
      leading: Icon(
        icon,
        color: _yellow,
      ),
      title: Text(
        title,
        style: const TextStyle(
          color: Colors.white,
          fontWeight: FontWeight.w600,
        ),
      ),
      childrenPadding: const EdgeInsets.fromLTRB(
        16,
        0,
        16,
        14,
      ),
      children: <Widget>[
        Align(
          alignment: Alignment.centerLeft,
          child: Text(
            _faqService.answer(question),
            style: const TextStyle(
              color: Colors.white70,
              height: 1.45,
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildSupportActions() {
    return Card(
      color: const Color(0xFF181818),
      child: Column(
        children: <Widget>[
          ListTile(
            leading: const Icon(
              Icons.support_agent,
              color: _yellow,
            ),
            title: const Text(
              'Human Support & Complaints',
              style: TextStyle(
                color: Colors.white,
              ),
            ),
            subtitle: const Text(
              'For real booking, payment, safety or account issues',
              style: TextStyle(
                color: Colors.white54,
              ),
            ),
            trailing: const Icon(
              Icons.chevron_right,
            ),
            onTap: _showHumanSupportInfo,
          ),
          const Divider(height: 1),
          ListTile(
            leading: const Icon(
              Icons.play_circle_outline,
              color: _yellow,
            ),
            title: const Text(
              'Video Tutorials',
              style: TextStyle(
                color: Colors.white,
              ),
            ),
            subtitle: const Text(
              'Step-by-step SWAT RIDE guides',
              style: TextStyle(
                color: Colors.white54,
              ),
            ),
            trailing: const Icon(
              Icons.chevron_right,
            ),
            onTap: _showVideoTutorialInfo,
          ),
        ],
      ),
    );
  }
}