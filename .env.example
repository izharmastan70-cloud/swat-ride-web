# ==============================================================================
# SWAT RIDE — ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# All public environment variables must begin with NEXT_PUBLIC_
# Private/server-only variables must NOT use NEXT_PUBLIC_ prefix.

# --- PUBLIC WEB CONFIGURATION (Safe for Browser) ---
NEXT_PUBLIC_SITE_URL=https://swatride.pk
NEXT_PUBLIC_SITE_NAME="SWAT RIDE"
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ur,ps

# --- GOOGLE PLAY STORE & APP DOWNLOAD PLACEHOLDERS ---
# Owner to replace with official published Play Store URL when live
NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=pk.swatride.app.placeholder
NEXT_PUBLIC_APPLE_APP_STORE_URL=https://apps.apple.com/app/swatride-placeholder
NEXT_PUBLIC_APP_DEEP_LINK_SCHEME=swatride://

# --- PUBLIC MAP / GEOLOCATION CONFIGURATION ---
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=replace_with_mapbox_public_access_token
NEXT_PUBLIC_DEFAULT_LAT=35.0563
NEXT_PUBLIC_DEFAULT_LNG=72.3588

# --- ANALYTICS & MONITORING (Public IDs) ---
# Replace with official property IDs in production
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION_ID=google-site-verification-placeholder

# ==============================================================================
# PRIVATE / OPERATIONAL & ADMIN SECRETS (NEVER EXPOSE IN NEXT_PUBLIC_)
# ==============================================================================
# AI Agent System Auth Hook Secret (for AI SEO, Blog, Error, & Monetization Agents)
INTERNAL_AI_AGENT_API_KEY=replace_with_internal_ai_agent_secret_key

# Firebase / Database Private Admin Config (Server-Side Privileged Operations)
FIREBASE_PROJECT_ID=swatride-prod-placeholder
FIREBASE_CLIENT_EMAIL=admin@swatride-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----"
FIREBASE_STORAGE_BUCKET=swatride-prod.appspot.com

# Email / SMS Provider Credentials (for server-side notifications)
SERVER_SMTP_HOST=smtp.mail-provider.placeholder
SERVER_SMTP_USER=no-reply@swatride.pk
SERVER_SMTP_PASS=replace_with_smtp_secret

# Super Admin Authorization Token (for protected status/report APIs)
SUPER_ADMIN_AUTH_SECRET=replace_with_super_admin_secret
